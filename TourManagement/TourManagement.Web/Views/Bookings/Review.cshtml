@model TourManagement.Web.Models.BookingReviewViewModel
@{
    ViewData["Title"] = "Kiểm tra thông tin Booking - Bước 3";
    Layout = "_Layout";
}

<!-- Stepper Container -->
<div class="booking-stepper-container mb-4 mt-3">
    <div class="step completed">
        <div class="step-icon"><i class="fas fa-check"></i></div>
        <div class="step-label">1. Chọn Tour</div>
    </div>
    <div class="step-line completed"></div>
    <div class="step completed">
        <div class="step-icon"><i class="fas fa-check"></i></div>
        <div class="step-label">2. Nhập thông tin</div>
    </div>
    <div class="step-line completed"></div>
    <div class="step active">
        <div class="step-icon">3</div>
        <div class="step-label">3. Kiểm tra</div>
    </div>
    <div class="step-line"></div>
    <div class="step">
        <div class="step-icon">4</div>
        <div class="step-label">4. Hoàn tất</div>
    </div>
</div>

<div class="row">
    <!-- Left Column: Booking Review Details -->
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4 border-0 rounded-4">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h4 class="mb-0 text-primary fw-bold"><i class="fas fa-clipboard-check me-2"></i> Xác nhận thông tin đặt tour</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-info rounded-3">
                    <i class="fas fa-info-circle me-2"></i> Vui lòng kiểm tra kỹ thông tin trước khi hoàn tất đặt tour.
                </div>
                
                <h5 class="fw-bold text-dark mt-4 border-bottom pb-2">1. Thông tin Tour</h5>
                <div class="row mb-3">
                    <div class="col-md-4 text-muted">Tên tour:</div>
                    <div class="col-md-8 fw-bold">@Model.TourName</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4 text-muted">Ngày khởi hành:</div>
                    <div class="col-md-8 fw-bold text-primary">@Model.DepartureDate.ToString("dd/MM/yyyy")</div>
                </div>

                <h5 class="fw-bold text-dark mt-4 border-bottom pb-2">2. Thông tin liên hệ</h5>
                <div class="row mb-3">
                    <div class="col-md-4 text-muted">Họ và tên:</div>
                    <div class="col-md-8 fw-bold">@Model.CustomerName</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4 text-muted">Số điện thoại:</div>
                    <div class="col-md-8 fw-bold">@Model.PhoneNumber</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4 text-muted">Email:</div>
                    <div class="col-md-8 fw-bold">@Model.Email</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Address))
                {
                    <div class="row mb-3">
                        <div class="col-md-4 text-muted">Địa chỉ:</div>
                        <div class="col-md-8 fw-bold">@Model.Address</div>
                    </div>
                }

                <h5 class="fw-bold text-dark mt-4 border-bottom pb-2">3. Chi tiết hành khách</h5>
                <div class="row mb-3">
                    <div class="col-md-4 text-muted">Người lớn:</div>
                    <div class="col-md-8 fw-bold">@Model.AdultCount</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4 text-muted">Trẻ em:</div>
                    <div class="col-md-8 fw-bold">@Model.ChildCount</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Price Summary and Form -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 rounded-4 sticky-top" style="top: 20px; z-index: 10;">
            <div class="card-header bg-primary text-white text-center py-3 rounded-top-4">
                <h5 class="mb-0 fw-bold">Chi tiết thanh toán</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Tổng tạm tính:</span>
                    <span class="fw-bold">@Model.OriginalPrice.ToString("N0") ₫</span>
                </div>
                @if (Model.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between mb-2 text-success">
                        <span>Giảm giá (@Model.PromoCode):</span>
                        <span class="fw-bold">-@Model.DiscountAmount.ToString("N0") ₫</span>
                    </div>
                }
                
                <hr>
                
                <div class="d-flex justify-content-between mb-4 align-items-center">
                    <span class="fw-bold text-dark fs-5">Thành tiền:</span>
                    <span class="fw-bold text-danger fs-3">@Model.FinalPrice.ToString("N0") ₫</span>
                </div>

                <form asp-action="ConfirmBooking" method="post">
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark"><i class="fas fa-wallet me-2 text-primary"></i> Phương thức thanh toán</label>
                        <select name="paymentMethod" class="form-select form-select-lg">
                            <option value="cash">Tiền mặt tại văn phòng</option>
                            <option value="transfer">Chuyển khoản ngân hàng</option>
                            <option value="momo">Thanh toán qua Momo</option>
                            <option value="card">Thẻ tín dụng / Ghi nợ</option>
                        </select>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm rounded-pill py-3">
                            <i class="fas fa-check-circle me-2"></i> Xác nhận đặt tour
                        </button>
                        <a href="@Url.Action("BookingDetails")" class="btn btn-outline-secondary btn-lg rounded-pill mt-2">
                            <i class="fas fa-arrow-left me-2"></i> Quay lại sửa
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
/* CSS for stepper */
.booking-stepper-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #fff;
    padding: 1.5rem;
    border-radius: 1rem;
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
}

.step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
}

.step-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: #e9ecef;
    color: #6c757d;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
    transition: all 0.3s ease;
}

.step-label {
    font-size: 0.9rem;
    color: #6c757d;
    font-weight: 500;
}

.step.active .step-icon {
    background-color: #0d6efd;
    color: #fff;
    box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.2);
}

.step.active .step-label {
    color: #0d6efd;
    font-weight: bold;
}

.step.completed .step-icon {
    background-color: #198754;
    color: #fff;
}

.step.completed .step-label {
    color: #198754;
}

.step-line {
    flex-grow: 1;
    height: 3px;
    background-color: #e9ecef;
    margin: 0 10px;
    position: relative;
    top: -12px;
}

.step-line.completed {
    background-color: #198754;
}
</style>
