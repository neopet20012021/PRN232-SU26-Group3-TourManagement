@model TourManagement.Business.DTOs.BookingDTO
@{
    ViewData["Title"] = "Đặt Tour Thành Công - Bước 4";
    Layout = "_Layout";
}

<!-- Stepper Container -->
<div class="row mb-4">
    <div class="col-md-12">
        <div class="d-flex justify-content-between position-relative wizard-stepper">
            <div class="step-item text-center completed">
                <div class="step-circle mx-auto"><i class="bi bi-check-lg"></i></div>
                <div class="step-label mt-2 small fw-bold">1. Chọn Tour</div>
            </div>
            <div class="step-item text-center completed">
                <div class="step-circle mx-auto"><i class="bi bi-check-lg"></i></div>
                <div class="step-label mt-2 small fw-bold">2. Nhập thông tin</div>
            </div>
            <div class="step-item text-center completed">
                <div class="step-circle mx-auto"><i class="bi bi-check-lg"></i></div>
                <div class="step-label mt-2 small fw-bold">3. Kiểm tra</div>
            </div>
            <div class="step-item text-center completed">
                <div class="step-circle mx-auto bg-success text-white border-success"><i class="bi bi-check-lg"></i></div>
                <div class="step-label mt-2 small text-success fw-bold">4. Hoàn tất</div>
            </div>
            <div class="stepper-line"></div>
        </div>
    </div>
</div>

<div class
                        <a href="/" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 8px;">
                            <i class="bi bi-house-door-fill me-1"></i> Về trang chủ
                        </a>
                        <a asp-action="Details" asp-route-code="@Model?.BookingCode" class="btn btn-primary px-4 py-2 fw-bold" style="border-radius: 8px;">
                            Xem chi tiết <i class="bi bi-arrow-right-short ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Wizard Stepper Styling */
    .wizard-stepper { max-width: 800px; margin: 30px auto; }
    .step-item { z-index: 2; position: relative; width: 25%; }
    .step-circle { width: 45px; height: 45px; border-radius: 50%; background-color: #f8f9fa; color: #6c757d; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: bold; border: 3px solid #e9ecef; transition: all 0.3s ease; }
    .step-item.active .step-circle { background-color: #0d6efd; color: white; border-color: #cce5ff; box-shadow: 0 0 0 5px rgba(13, 110, 253, 0.15); }
    .step-item.completed .step-circle { background-color: #198754; color: white; border-color: #d1e7dd; }
    .step-label { color: #6c757d; transition: all 0.3s ease; font-weight: 500; }
    .step-item.active .step-label { color: #0d6efd; font-weight: 700; }
    .step-item.completed .step-label { color: #198754; }
    .stepper-line { position: absolute; top: 22px; left: 12.5%; width: 75%; height: 3px; background-color: #e9ecef; z-index: 1; }
    
    .stepper-line::before {
        content: ''; position: absolute; top: 0; left: 0; height: 100%; width: 100%; background-color: #198754; z-index: 2;
    }
</style>
