<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TourManagement</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        * { font-family: 'Inter', sans-serif; }
        body { background: #f8f9fb; }
        .navbar-brand { font-weight: 700; font-size: 1.1rem; }
        .navbar { box-shadow: 0 2px 12px rgba(0,0,0,0.08); }
        .nav-link { font-weight: 500; font-size: 0.9rem; }
        .badge-role { font-size: 0.7rem; border-radius: 6px; padding: 2px 7px; vertical-align: middle; }
        .btn-logout {
            background: none; border: 1px solid rgba(255,255,255,0.3);
            color: rgba(255,255,255,0.85); border-radius: 8px;
            font-size: 0.875rem; padding: 5px 14px; font-weight: 500;
            transition: all 0.2s;
        }
        .btn-logout:hover { background: rgba(255,255,255,0.15); color: white; border-color: white; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark" style="background: linear-gradient(135deg, #302b63, #24243e);">
            <div class="container-fluid">
                <a class="navbar-brand text-white" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-compass me-2" style="color:#a5b4fc"></i>TourManagement
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white-50" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-grid me-1"></i>Quản Lý Booking
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Customer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white-50" asp-controller="Bookings" asp-action="Create">
                                        <i class="bi bi-ticket-perforated me-1"></i>Đặt Tour
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center me-2">
                                <span class="text-white-50 small me-2">
                                    <i class="bi bi-person-circle me-1"></i>
                                    @(User.FindFirst("FullName")?.Value ?? User.Identity?.Name)
                                </span>
                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="badge bg-danger badge-role">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary badge-role">Customer</span>
                                }
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-logout btn">
                                        <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i>Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid py-4 px-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top mt-4 py-3 text-center text-muted small">
        &copy; 2026 TourManagement - PRN232 Group 3
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
