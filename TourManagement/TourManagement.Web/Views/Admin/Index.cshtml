@model TourManagement.Web.Models.AdminBookingListViewModel
@{
    ViewData["Title"] = "Quản Lý Booking";
    var tours = ViewBag.Tours as List<TourManagement.Business.DTOs.TourSelectDTO> ?? new();
    var statuses = new[] { "pending", "confirmed", "cancelled", "completed" };
}

<div class="admin-header d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="mb-1"><i class="bi bi-grid-3x3-gap me-2 text-primary"></i>Quản Lý Booking</h2>
        <p class="text-muted mb-0">Tổng: <strong>@Model.TotalCount</strong> booking</p>
    </div>
    <button class="btn btn-primary rounded-3 px-4" data-bs-toggle="modal" data-bs-target="#createModal" id="btn-create">
        <i class="bi bi-plus-lg me-2"></i>Thêm Booking
    </button>
</div>

<!-- Search & Filter -->
<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-semibold text-muted mb-1">Tìm kiếm</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="keyword" class="form-control border-start-0 bg-light"
                           placeholder="Mã booking, tên KH, email, SĐT, tour..." value="@Model.SearchKeyword" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Trạng thái</label>
                <select name="status" class="form-select bg-light">
                    <option value="">-- Tất cả --</option>
                    @foreach (var s in statuses)
                    {
                        <option value="@s" selected="@(Model.StatusFilter == s)">@s.ToUpper()</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 rounded-3">
                    <i class="bi bi-funnel me-1"></i>Lọc
                </button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100 rounded-3">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Booking Table -->
<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="bookingTable">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Mã Booking</th>
                        <th>Tour</th>
                        <th>Khách Hàng</th>
                        <th>Liên Hệ</th>
                        <th>Số Người</th>
                        <th>Tổng Tiền</th>
                        <th>Trạng Thái</th>
                        <th class="text-center pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Bookings.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Không có booking nào
                            </td>
                        </tr>
                    }
                    @foreach (var b in Model.Bookings)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-primary-subtle text-primary fw-semibold">@b.BookingCode</span>
                                <div class="small text-muted">@b.CreatedDate.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td><span class="text-truncate d-block" style="max-width:160px" title="@b.TourName">@b.TourName</span></td>
                            <td>
                                <strong>@b.CustomerName</strong>
                                @if (!string.IsNullOrEmpty(b.Email))
                                {
                                    <div class="small text-muted">@b.Email</div>
                                }
                            </td>
                            <td><small>@b.PhoneNumber</small></td>
                            <td>
                                <small>
                                    @if (b.AdultCount > 0) { <span>@b.AdultCount NL</span> }
                                    @if (b.ChildCount > 0) { <span class="ms-1">@b.ChildCount TE</span> }
                                </small>
                            </td>
                            <td><strong class="text-success">@b.FinalPrice.ToString("N0") đ</strong></td>
                            <td>
                                @{
                                    var badgeClass = b.Status switch {
                                        "confirmed" => "bg-success-subtle text-success",
                                        "cancelled" => "bg-danger-subtle text-danger",
                                        "completed" => "bg-info-subtle text-info",
                                        _ => "bg-warning-subtle text-warning"
                                    };
                                }
                                <span class="badge @badgeClass fw-semibold text-uppercase">@b.Status</span>
                            </td>
                            <td class="text-center pe-4">
                                <button class="btn btn-sm btn-outline-primary rounded-3 me-1"
                                        onclick="openEditModal(@b.BookingId)" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-3"
                                        onclick="confirmDelete(@b.BookingId, '@b.BookingCode')" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ══════════ CREATE MODAL ══════════ -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Thêm Booking Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="createForm">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Tour <span class="text-danger">*</span></label>
                            <select name="TourId" id="create-TourId" class="form-select" required>
                                <option value="">-- Chọn tour --</option>
                                @foreach (var t in tours)
                                {
                                    <option value="@t.TourId">@t.TourName (@t.DepartureDate.ToString("dd/MM/yyyy"))</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tên khách hàng <span class="text-danger">*</span></label>
                            <input type="text" name="CustomerName" class="form-control" placeholder="Họ và tên" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="text" name="PhoneNumber" class="form-control" placeholder="0912345678" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                            <input type="email" name="Email" class="form-control" placeholder="email@example.com" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phương thức thanh toán</label>
                            <select name="PaymentMethod" class="form-select">
                                <option value="cash">Tiền mặt</option>
                                <option value="transfer">Chuyển khoản</option>
                                <option value="card">Thẻ tín dụng</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Số người lớn</label>
                            <input type="number" name="AdultCount" class="form-control" value="1" min="1" max="100" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Số trẻ em</label>
                            <input type="number" name="ChildCount" class="form-control" value="0" min="0" max="100" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Mã giảm giá</label>
                            <input type="text" name="PromoCode" class="form-control" placeholder="Nếu có" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Yêu cầu đặc biệt</label>
                            <textarea name="SpecialRequest" class="form-control" rows="2" placeholder="Ghi chú..."></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-3 px-4" onclick="submitCreate()">
                    <i class="bi bi-check-lg me-1"></i>Lưu Booking
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══════════ EDIT MODAL ══════════ -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header bg-warning text-dark rounded-top-4">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Chỉnh Sửa Booking</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="editForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="edit-BookingId" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tên khách hàng <span class="text-danger">*</span></label>
                            <input type="text" id="edit-CustomerName" name="CustomerName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="text" id="edit-PhoneNumber" name="PhoneNumber" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                            <input type="email" id="edit-Email" name="Email" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Trạng thái</label>
                            <select id="edit-Status" name="Status" class="form-select">
                                <option value="pending">PENDING</option>
                                <option value="confirmed">CONFIRMED</option>
                                <option value="completed">COMPLETED</option>
                                <option value="cancelled">CANCELLED</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Số người lớn</label>
                            <input type="number" id="edit-AdultCount" name="AdultCount" class="form-control" min="1" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Số trẻ em</label>
                            <input type="number" id="edit-ChildCount" name="ChildCount" class="form-control" min="0" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Phương thức TT</label>
                            <select id="edit-PaymentMethod" name="PaymentMethod" class="form-select">
                                <option value="cash">Tiền mặt</option>
                                <option value="transfer">Chuyển khoản</option>
                                <option value="card">Thẻ tín dụng</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Yêu cầu đặc biệt</label>
                            <textarea id="edit-SpecialRequest" name="SpecialRequest" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Ghi chú nội bộ</label>
                            <textarea id="edit-Notes" name="Notes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning rounded-3 px-4" onclick="submitEdit()">
                    <i class="bi bi-check-lg me-1"></i>Cập Nhật
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══════════ DELETE CONFIRM MODAL ══════════ -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-body text-center p-5">
                <div class="mb-3" style="font-size:56px;color:#ef4444"><i class="bi bi-trash3"></i></div>
                <h5 class="fw-bold mb-2">Xác nhận xóa?</h5>
                <p class="text-muted">Bạn có chắc muốn xóa booking <strong id="delete-code"></strong>? Hành động này không thể hoàn tác.</p>
                <input type="hidden" id="delete-id" />
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Hủy</button>
                    <button class="btn btn-danger rounded-3 px-4" onclick="submitDelete()">
                        <i class="bi bi-trash me-1"></i>Xóa
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="position-fixed top-0 end-0 p-3" style="z-index:9999">
    <div id="toast-msg" class="toast align-items-center text-white border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body fw-semibold" id="toast-text"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    function showToast(msg, success) {
        const el = document.getElementById('toast-msg');
        el.className = 'toast align-items-center text-white border-0 ' + (success ? 'bg-success' : 'bg-danger');
        document.getElementById('toast-text').textContent = msg;
        new bootstrap.Toast(el, { delay: 3000 }).show();
    }

    function confirmDelete(id, code) {
        document.getElementById('delete-id').value = id;
        document.getElementById('delete-code').textContent = code;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }

    function submitDelete() {
        const id = document.getElementById('delete-id').value;
        fetch('/Admin/DeleteBooking', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: 'id=' + id
        }).then(r => r.json()).then(data => {
            bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
            showToast(data.message, data.success);
            if (data.success) setTimeout(() => location.reload(), 800);
        });
    }

    function openEditModal(id) {
        fetch('/Admin/GetBooking/' + id)
            .then(r => r.json())
            .then(b => {
                document.getElementById('edit-BookingId').value = b.bookingId;
                document.getElementById('edit-CustomerName').value = b.customerName;
                document.getElementById('edit-PhoneNumber').value = b.phoneNumber;
                document.getElementById('edit-Email').value = b.email;
                document.getElementById('edit-Status').value = b.status;
                document.getElementById('edit-AdultCount').value = b.adultCount;
                document.getElementById('edit-ChildCount').value = b.childCount;
                document.getElementById('edit-PaymentMethod').value = b.paymentMethod;
                document.getElementById('edit-SpecialRequest').value = b.specialRequest || '';
                document.getElementById('edit-Notes').value = b.notes || '';
                new bootstrap.Modal(document.getElementById('editModal')).show();
            });
    }

    function submitEdit() {
        const id = document.getElementById('edit-BookingId').value;
        const form = document.getElementById('editForm');
        const data = new URLSearchParams(new FormData(form));
        data.append('bookingId', id);
        fetch('/Admin/UpdateBooking', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: data.toString()
        }).then(r => r.json()).then(res => {
            bootstrap.Modal.getInstance(document.getElementById('editModal')).hide();
            showToast(res.message, res.success);
            if (res.success) setTimeout(() => location.reload(), 800);
        });
    }

    function submitCreate() {
        const form = document.getElementById('createForm');
        const data = new URLSearchParams(new FormData(form));
        fetch('/Admin/CreateBooking', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: data.toString()
        }).then(r => r.json()).then(res => {
            if (res.success) {
                bootstrap.Modal.getInstance(document.getElementById('createModal')).hide();
                showToast(res.message, true);
                setTimeout(() => location.reload(), 800);
            } else {
                showToast(res.message, false);
            }
        });
    }
</script>
}
