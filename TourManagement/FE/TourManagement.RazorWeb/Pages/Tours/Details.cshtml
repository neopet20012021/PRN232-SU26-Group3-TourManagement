@page
@model TourManagement.RazorWeb.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

<style>
    body {
        background-color: var(--color-bg-body, #f8fafc);
    }
    
    .hero-banner {
        position: relative;
        height: 400px;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 1.5rem;
    }
    
    .hero-banner img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .tour-header {
        margin-bottom: 2rem;
    }

    .badge-premium {
        background: var(--color-primary-light, #e0f2fe);
        color: var(--color-primary, #0284c7);
        border: 1px solid #bae6fd;
    }

    .tour-title {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 2.5rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 1rem;
    }

    .info-card {
        background: #fff;
        border-radius: 12px;
        padding: 1.5rem;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        height: 100%;
    }
    
    .info-icon-wrapper {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: var(--color-primary-light, #e0f2fe);
        color: var(--color-primary, #0284c7);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .section-title {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 700;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .overview-text {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #475569;
    }

    /* Timeline */
    .timeline {
        position: relative;
        padding-left: 2rem;
        margin-bottom: 0;
    }
    .timeline::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #e2e8f0;
    }
    .timeline-item {
        position: relative;
        margin-bottom: 1.5rem;
    }
    .timeline-item:last-child {
        margin-bottom: 0;
    }
    .timeline-item::before {
        content: '';
        position: absolute;
        left: -2.35rem;
        top: 0.25rem;
        width: 1rem;
        height: 1rem;
        border-radius: 50%;
        background: var(--color-primary, #0284c7);
        border: 3px solid #e0f2fe;
    }
    .timeline-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.25rem;
    }

    /* Checklists */
    .checklist {
        list-style: none;
        padding: 0;
    }
    .checklist li {
        position: relative;
        padding-left: 2rem;
        margin-bottom: 0.75rem;
        line-height: 1.5;
        color: #475569;
    }
    .checklist.included li::before {
        content: '\F26E'; /* bi-check-circle-fill */
        font-family: 'bootstrap-icons';
        position: absolute;
        left: 0;
        top: 0;
        color: #16a34a;
        font-size: 1.1rem;
    }
    .checklist.excluded li::before {
        content: '\F623'; /* bi-x-circle-fill */
        font-family: 'bootstrap-icons';
        position: absolute;
        left: 0;
        top: 0;
        color: #dc2626;
        font-size: 1.1rem;
    }

    /* Sticky Sidebar */
    .booking-sidebar {
        position: sticky;
        top: 2rem;
        background: #fff;
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1);
        border: 1px solid #e2e8f0;
    }

    .price-display {
        font-size: 2rem;
        font-weight: 800;
        color: var(--color-accent, #ea580c);
    }

    /* Related Tours */
    .tour-card {
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
        background: #fff;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .tour-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
    .tour-card img {
        height: 200px;
        width: 100%;
        object-fit: cover;
    }

    /* Reviews */
    .review-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.5rem;
        height: 100%;
    }
    .avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
    }


    .badge-criteria {
        font-size: 0.825rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        padding: 0.4em 0.75em;
    }
    .badge-cleanliness {
        background-color: #e0f2fe !important;
        color: #0284c7 !important;
        border: 1px solid #bae6fd;
    }
    .badge-comfort {
        background-color: #ffe4e6 !important;
        color: #e11d48 !important;
        border: 1px solid #fecdd3;
    }
    .badge-amenities {
        background-color: #fef3c7 !important;
        color: #d97706 !important;
        border: 1px solid #fde68a;
    }
    .badge-value {
        background-color: #dcfce7 !important;
        color: #16a34a !important;
        border: 1px solid #bbf7d0;
    }
    .cursor-pointer {
        cursor: pointer;
    }

    /* CTA Section */
    .cta-section {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: white;
        padding: 4rem 0;
        border-radius: 24px;
        margin-top: 4rem;
        text-align: center;
    }
</style>

@if (Model.Schedule == null || Model.Schedule.Tour == null)
{
    <div class="container mt-5">
        <div class="alert alert-danger shadow-sm rounded-3"><i class="bi bi-exclamation-triangle-fill"></i> Tour not found.</div>
    </div>
}
else
{
    <div class="container py-4">
        
        <!-- HERO IMAGE -->
        <div class="hero-banner shadow-sm">
            <img src="@(string.IsNullOrEmpty(Model.Schedule.Tour.Image) ? "https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&q=80&w=2070" : Model.Schedule.Tour.Image)" alt="@Model.Schedule.Tour.TourName">
        </div>

        <!-- TOUR HEADER (BELOW IMAGE) -->
        <div class="tour-header">
            <div class="d-flex gap-2 mb-3 flex-wrap">
                <span class="badge badge-premium px-3 py-2 rounded-pill"><i class="bi bi-star-fill text-warning"></i> @(Model.ReviewSummary?.TotalReviews > 0 ? Model.ReviewSummary.AverageRating.ToString("0.0") : "5.0") (@(Model.ReviewSummary?.TotalReviews ?? 0) Đánh giá)</span>
                <span class="badge badge-premium px-3 py-2 rounded-pill"><i class="bi bi-shield-check text-success"></i> Hủy miễn phí</span>
                <span class="badge badge-premium px-3 py-2 rounded-pill"><i class="bi bi-lightning-charge-fill text-warning"></i> Xác nhận ngay</span>
                <span class="badge bg-danger px-3 py-2 rounded-pill fw-bold"><i class="bi bi-fire"></i> Bán Chạy Nhất</span>
            </div>
            <h1 class="tour-title">@Model.Schedule.Tour.TourName</h1>
            <div class="d-flex flex-wrap gap-4 text-muted fw-medium fs-5">
                <span><i class="bi bi-geo-alt-fill text-danger"></i> @Model.Schedule.Tour.Destination</span>
                <span><i class="bi bi-clock-fill text-info"></i> @Model.Schedule.Tour.Days Ngày @Model.Schedule.Tour.Nights Đêm</span>
                <span><i class="bi bi-calendar-event text-primary"></i> @Model.Schedule.StartDate.ToString("dd/MM/yyyy")</span>
            </div>
        </div>

        <div class="row g-4">
            <!-- MAIN CONTENT (LEFT) -->
            <div class="col-lg-8">
                
                <!-- QUICK INFORMATION -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="info-card text-center">
                            <div class="info-icon-wrapper mx-auto"><i class="bi bi-map"></i></div>
                            <small class="text-muted d-block mb-1">Điểm đến</small>
                            <strong class="text-dark">@Model.Schedule.Tour.Destination</strong>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="info-card text-center">
                            <div class="info-icon-wrapper mx-auto"><i class="bi bi-stopwatch"></i></div>
                            <small class="text-muted d-block mb-1">Thời lượng</small>
                            <strong class="text-dark">@Model.Schedule.Tour.Days Ngày @Model.Schedule.Tour.Nights Đêm</strong>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="info-card text-center">
                            <div class="info-icon-wrapper mx-auto"><i class="bi bi-bus-front"></i></div>
                            <small class="text-muted d-block mb-1">Phương tiện</small>
                            <strong class="text-dark">Xe khách / Máy bay</strong>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="info-card text-center">
                            <div class="info-icon-wrapper mx-auto"><i class="bi bi-globe"></i></div>
                            <small class="text-muted d-block mb-1">Ngôn ngữ</small>
                            <strong class="text-dark">Tiếng Việt / English</strong>
                        </div>
                    </div>
                </div>

                <!-- OVERVIEW -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4 p-md-5">
                        <h4 class="section-title"><i class="bi bi-card-text text-primary"></i> Tổng Quan Hành Trình</h4>
                        <div class="overview-text">
                            @Html.Raw(Model.Schedule.Tour.Description?.Replace("\n", "<br/>"))
                        </div>
                    </div>
                </div>

                <!-- ITINERARY -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4 p-md-5">
                        <h4 class="section-title"><i class="bi bi-signpost-split text-primary"></i> Lịch Trình Chi Tiết</h4>
                        
                        <div id="itineraryContainer" class="timeline mt-4">
                            <!-- JS Will Populate This -->
                            <div class="d-none" id="rawItinerary">@Model.Schedule.Tour.Itinerary</div>
                        </div>
                    </div>
                </div>

                <!-- INCLUDED & EXCLUDED -->
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body p-4">
                                <h5 class="fw-bold mb-4 text-success"><i class="bi bi-check-circle-fill me-2"></i> Dịch Vụ Bao Gồm</h5>
                                <ul class="checklist included" id="includedList">
                                    <div class="d-none" id="rawIncluded">@Model.Schedule.Tour.IncludedServices</div>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body p-4">
                                <h5 class="fw-bold mb-4 text-danger"><i class="bi bi-x-circle-fill me-2"></i> Không Bao Gồm</h5>
                                <ul class="checklist excluded" id="excludedList">
                                    <div class="d-none" id="rawExcluded">@Model.Schedule.Tour.ExcludedServices</div>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- DYNAMIC CUSTOMER REVIEWS & RATING FORM -->
                <div class="card border-0 shadow-sm rounded-4 mb-4" id="reviews-section">
                    <div class="card-body p-4 p-md-5">
                        <h4 class="section-title mb-4"><i class="bi bi-star-half text-warning"></i> Đánh Giá Chi Tiết Từ Khách Hàng</h4>
                        
                        @{
                            var totalReviews = Model.ReviewSummary?.TotalReviews ?? 0;
                            var avgRating = Model.ReviewSummary?.AverageRating ?? 0;
                            var avgCleanliness = Model.ReviewSummary?.AvgCleanliness ?? 0;
                            var avgComfort = Model.ReviewSummary?.AvgComfort ?? 0;
                            var avgAmenities = Model.ReviewSummary?.AvgAmenities ?? 0;
                            var avgValue = Model.ReviewSummary?.AvgValue ?? 0;
                        }

                        <div class="row g-4 mb-5 p-4 bg-light rounded-4 align-items-center">
                            <!-- Overall Rating Box -->
                            <div class="col-md-4 text-center border-end-md">
                                <h1 class="display-3 fw-bold text-dark mb-0">@(totalReviews > 0 ? avgRating.ToString("0.0") : "0.0")</h1>
                                <div class="text-warning fs-4 mb-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Round(avgRating))
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-muted"></i>
                                        }
                                    }
                                </div>
                                <span class="text-muted">Dựa trên @totalReviews Đánh giá</span>
                            </div>

                            <!-- Detailed Criteria Breakdown Bars -->
                            <div class="col-md-8">
                                <div class="row g-3">
                                    <div class="col-6">
                                        <div class="d-flex justify-content-between mb-1">
                                            <small class="fw-bold text-dark"><i class="bi bi-stars text-info me-1"></i> Sạch sẽ</small>
                                            <small class="fw-bold text-primary">@avgCleanliness / 5.0</small>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-info" style="width: @(avgCleanliness * 20)%"></div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="d-flex justify-content-between mb-1">
                                            <small class="fw-bold text-dark"><i class="bi bi-heart-fill text-danger me-1"></i> Thoải mái</small>
                                            <small class="fw-bold text-primary">@avgComfort / 5.0</small>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-danger" style="width: @(avgComfort * 20)%"></div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="d-flex justify-content-between mb-1">
                                            <small class="fw-bold text-dark"><i class="bi bi-cup-hot-fill text-warning me-1"></i> Tiện ích & Dịch vụ</small>
                                            <small class="fw-bold text-primary">@avgAmenities / 5.0</small>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-warning" style="width: @(avgAmenities * 20)%"></div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="d-flex justify-content-between mb-1">
                                            <small class="fw-bold text-dark"><i class="bi bi-tag-fill text-success me-1"></i> Phù hợp / Đáng giá</small>
                                            <small class="fw-bold text-primary">@avgValue / 5.0</small>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-success" style="width: @(avgValue * 20)%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- SUBMIT DETAILED REVIEW FORM -->
                        <div class="card bg-light border-0 rounded-4 p-4 mb-5 shadow-sm">
                            <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-pencil-square me-2"></i> Gửi Đánh Giá Chi Tiết Của Bạn</h5>
                            
                            @if (!string.IsNullOrEmpty(Model.ReviewSuccessMessage))
                            {
                                <div class="alert alert-success rounded-3"><i class="bi bi-check-circle-fill me-2"></i> @Model.ReviewSuccessMessage</div>
                            }
                            @if (!string.IsNullOrEmpty(Model.ReviewErrorMessage))
                            {
                                <div class="alert alert-danger rounded-3"><i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ReviewErrorMessage</div>
                            }

                            <form method="post" asp-page-handler="Review" asp-route-scheduleId="@Model.Schedule.ScheduleId">
                                <input type="hidden" asp-for="NewReview.Rating" id="ratingInput" value="5" />
                                <input type="hidden" asp-for="NewReview.CleanlinessRating" id="cleanlinessInput" value="5" />
                                <input type="hidden" asp-for="NewReview.ComfortRating" id="comfortInput" value="5" />
                                <input type="hidden" asp-for="NewReview.AmenitiesRating" id="amenitiesInput" value="5" />
                                <input type="hidden" asp-for="NewReview.ValueRating" id="valueInput" value="5" />

                                <div class="mb-4">
                                    <label class="form-label fw-bold text-dark">Họ và Tên:</label>
                                    <input type="text" asp-for="NewReview.CustomerName" class="form-control rounded-3 border bg-white" placeholder="Nhập tên của bạn..." required />
                                </div>

                                <!-- Multi-Criteria Star Pickers -->
                                <div class="mb-4 bg-white p-4 rounded-3 border">
                                    <div class="row g-4">
                                        <div class="col-md-12">
                                            <label class="form-label fw-bold text-primary mb-1">Đánh giá tổng quan (Tự động tính): <span id="overallRatingValue" class="text-secondary fw-normal">5.0 / 5.0</span></label>
                                            <div class="star-picker fs-3 text-warning" data-target="ratingInput" style="pointer-events: none; opacity: 0.85;">
                                                <i class="bi bi-star-fill star-item" data-val="1"></i>
                                                <i class="bi bi-star-fill star-item" data-val="2"></i>
                                                <i class="bi bi-star-fill star-item" data-val="3"></i>
                                                <i class="bi bi-star-fill star-item" data-val="4"></i>
                                                <i class="bi bi-star-fill star-item" data-val="5"></i>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-dark mb-1"><i class="bi bi-stars text-info me-1"></i> Sạch sẽ:</label>
                                            <div class="star-picker fs-4 text-warning cursor-pointer" data-target="cleanlinessInput">
                                                <i class="bi bi-star-fill star-item" data-val="1"></i>
                                                <i class="bi bi-star-fill star-item" data-val="2"></i>
                                                <i class="bi bi-star-fill star-item" data-val="3"></i>
                                                <i class="bi bi-star-fill star-item" data-val="4"></i>
                                                <i class="bi bi-star-fill star-item" data-val="5"></i>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-dark mb-1"><i class="bi bi-heart-fill text-danger me-1"></i> Thoải mái:</label>
                                            <div class="star-picker fs-4 text-warning cursor-pointer" data-target="comfortInput">
                                                <i class="bi bi-star-fill star-item" data-val="1"></i>
                                                <i class="bi bi-star-fill star-item" data-val="2"></i>
                                                <i class="bi bi-star-fill star-item" data-val="3"></i>
                                                <i class="bi bi-star-fill star-item" data-val="4"></i>
                                                <i class="bi bi-star-fill star-item" data-val="5"></i>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-dark mb-1"><i class="bi bi-cup-hot-fill text-warning me-1"></i> Tiện ích & Dịch vụ:</label>
                                            <div class="star-picker fs-4 text-warning cursor-pointer" data-target="amenitiesInput">
                                                <i class="bi bi-star-fill star-item" data-val="1"></i>
                                                <i class="bi bi-star-fill star-item" data-val="2"></i>
                                                <i class="bi bi-star-fill star-item" data-val="3"></i>
                                                <i class="bi bi-star-fill star-item" data-val="4"></i>
                                                <i class="bi bi-star-fill star-item" data-val="5"></i>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-dark mb-1"><i class="bi bi-tag-fill text-success me-1"></i> Phù hợp / Đáng giá:</label>
                                            <div class="star-picker fs-4 text-warning cursor-pointer" data-target="valueInput">
                                                <i class="bi bi-star-fill star-item" data-val="1"></i>
                                                <i class="bi bi-star-fill star-item" data-val="2"></i>
                                                <i class="bi bi-star-fill star-item" data-val="3"></i>
                                                <i class="bi bi-star-fill star-item" data-val="4"></i>
                                                <i class="bi bi-star-fill star-item" data-val="5"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold text-dark">Nội dung nhận xét:</label>
                                    <textarea asp-for="NewReview.Comment" class="form-control rounded-3 border bg-white" rows="3" placeholder="Chia sẻ chi tiết cảm nhận của bạn về chuyến đi..." required></textarea>
                                </div>

                                <button type="submit" class="btn btn-primary px-4 py-2.5 rounded-pill fw-bold shadow-sm">
                                    <i class="bi bi-send-fill me-2"></i> Gửi Đánh Giá Chi Tiết
                                </button>
                            </form>
                        </div>

                        <!-- REVIEW LIST -->
                        <h5 class="fw-bold mb-4">Các nhận xét gần đây</h5>
                        @if (Model.ReviewSummary?.Reviews != null && Model.ReviewSummary.Reviews.Any())
                        {
                            <div class="row g-4">
                                @foreach (var review in Model.ReviewSummary.Reviews)
                                {
                                    <div class="col-md-6">
                                        <div class="review-card shadow-sm h-100">
                                            <div class="d-flex gap-3 mb-3 align-items-center">
                                                <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5" style="width: 48px; height: 48px;">
                                                    @(string.IsNullOrEmpty(review.CustomerName) ? "K" : review.CustomerName.Substring(0, 1).ToUpper())
                                                </div>
                                                <div>
                                                    <h6 class="fw-bold mb-0">@review.CustomerName</h6>
                                                    <small class="text-muted">@review.CreatedDate.ToString("dd/MM/yyyy HH:mm")</small>
                                                </div>
                                                <div class="ms-auto text-warning fs-6">
                                                    @for (int s = 1; s <= 5; s++)
                                                    {
                                                        if (s <= review.Rating)
                                                        {
                                                            <i class="bi bi-star-fill"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-star text-muted"></i>
                                                        }
                                                    }
                                                </div>
                                            </div>

                                            <!-- High Contrast Criteria Badges -->
                                            <div class="d-flex flex-wrap gap-2 mb-3">
                                                <span class="badge badge-criteria badge-cleanliness rounded-pill"><i class="bi bi-stars me-1"></i> Sạch sẽ: @review.CleanlinessRating★</span>
                                                <span class="badge badge-criteria badge-comfort rounded-pill"><i class="bi bi-heart-fill me-1"></i> Thoải mái: @review.ComfortRating★</span>
                                                <span class="badge badge-criteria badge-amenities rounded-pill"><i class="bi bi-cup-hot-fill me-1"></i> Tiện ích: @review.AmenitiesRating★</span>
                                                <span class="badge badge-criteria badge-value rounded-pill"><i class="bi bi-tag-fill me-1"></i> Phù hợp: @review.ValueRating★</span>
                                            </div>

                                            <p class="text-muted mb-0">@review.Comment</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted text-center py-4">Chưa có nhận xét nào cho tour này. Hãy là người đầu tiên gửi đánh giá!</div>
                        }
                    </div>
                </div>
            </div>

            <!-- SIDEBAR (RIGHT) -->
            <div class="col-lg-4">
                <div class="booking-sidebar">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="badge bg-danger px-2 py-1"><i class="bi bi-percent"></i> Tiết kiệm tới 15%</span>
                        <span class="text-muted"><i class="bi bi-eye"></i> 45 người đang xem</span>
                    </div>
                    
                    <p class="text-muted mb-1">Giá từ</p>
                    <div class="price-display mb-1">@Model.Schedule.ActualAdultPrice.ToString("N0") <span class="fs-4 text-dark fw-bold">VND</span></div>
                    <p class="text-muted fs-6 mb-4">/ Người lớn</p>

                    <div class="bg-light rounded-3 p-3 mb-4">
                        <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                            <span class="text-muted"><i class="bi bi-calendar-event me-2"></i>Khởi hành</span>
                            <strong class="text-dark">@Model.Schedule.StartDate.ToString("dd/MM/yyyy")</strong>
                        </div>
                        <div class="d-flex justify-content-between pb-2 mb-2 border-bottom">
                            <span class="text-muted"><i class="bi bi-clock me-2"></i>Thời gian</span>
                            <strong class="text-dark">@Model.Schedule.Tour.Days Ngày</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted"><i class="bi bi-people me-2"></i>Chỗ trống</span>
                            <strong class="text-danger">Còn @Model.Schedule.AvailableSeats chỗ</strong>
                        </div>
                    </div>

                    <a href="/Tours/Book?scheduleId=@Model.Schedule.ScheduleId" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow py-3 mb-3 fs-5">
                        Đặt Ngay <i class="bi bi-arrow-right ms-2"></i>
                    </a>

                    <button class="btn btn-outline-secondary w-100 rounded-pill fw-bold py-2 mb-4">
                        <i class="bi bi-chat-dots me-2"></i> Cần hỗ trợ?
                    </button>

                    <div class="d-flex flex-column gap-2 text-muted small">
                        <div><i class="bi bi-shield-check text-success me-2"></i> Thanh toán an toàn, bảo mật 100%</div>
                        <div><i class="bi bi-headset text-primary me-2"></i> Hỗ trợ khách hàng 24/7</div>
                        <div><i class="bi bi-star-fill text-warning me-2"></i> Cam kết chất lượng dịch vụ tốt nhất</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RELATED TOURS -->
        @if (Model.RelatedSchedules != null && Model.RelatedSchedules.Any())
        {
            <div class="mt-5 pt-4">
                <h3 class="fw-bold mb-4" style="font-family: 'Plus Jakarta Sans', sans-serif;">Có Thể Bạn Sẽ Thích</h3>
                <div class="row g-4">
                    @foreach (var rel in Model.RelatedSchedules)
                    {
                        <div class="col-md-4">
                            <div class="tour-card h-100">
                                <img src="@(string.IsNullOrEmpty(rel.Tour?.Image) ? "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=600&auto=format&fit=crop" : rel.Tour?.Image)" alt="@rel.Tour?.TourName">
                                <div class="p-4">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="badge bg-primary bg-opacity-10 text-primary">@rel.Tour?.Destination</span>
                                        <span class="text-warning fw-bold">★ 4.8</span>
                                    </div>
                                    <h5 class="fw-bold mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 3rem;">@rel.Tour?.TourName</h5>
                                    <div class="d-flex justify-content-between align-items-end">
                                        <div>
                                            <small class="text-muted d-block">Giá từ</small>
                                            <strong class="fs-5 text-danger">@rel.ActualAdultPrice.ToString("N0") VND</strong>
                                        </div>
                                        <a href="/Tours/Details?scheduleId=@rel.ScheduleId" class="btn btn-outline-primary btn-sm rounded-pill px-3">Chi tiết</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- CTA SECTION -->
        <div class="cta-section shadow">
            <h2 class="fw-bold mb-3" style="font-family: 'Plus Jakarta Sans', sans-serif;">Sẵn sàng khám phá @Model.Schedule.Tour.Destination?</h2>
            <p class="fs-5 opacity-75 mb-4">Hàng ngàn khách hàng đã trải nghiệm và hài lòng. Đừng bỏ lỡ cơ hội này!</p>
            <a href="/Tours/Book?scheduleId=@Model.Schedule.ScheduleId" class="btn btn-light btn-lg px-5 py-3 rounded-pill fw-bold text-primary shadow-lg" style="font-size: 1.2rem;">
                Đặt Tour Này Ngay <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>

    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Parse Included Services
            let rawIncluded = document.getElementById('rawIncluded')?.textContent;
            if(rawIncluded) {
                let items = rawIncluded.split('\n').map(x => x.trim()).filter(x => x.length > 0);
                document.getElementById('includedList').innerHTML = items.map(x => `<li>${x}</li>`).join('');
            }

            // Parse Excluded Services
            let rawExcluded = document.getElementById('rawExcluded')?.textContent;
            if(rawExcluded) {
                let items = rawExcluded.split('\n').map(x => x.trim()).filter(x => x.length > 0);
                document.getElementById('excludedList').innerHTML = items.map(x => `<li>${x}</li>`).join('');
            }

            // Parse Itinerary into Timeline
            let rawItinerary = document.getElementById('rawItinerary')?.textContent;
            let container = document.getElementById('itineraryContainer');
            if(rawItinerary && container) {
                // Split by both newlines and pipe symbols, then filter out empty entries
                let rawLines = rawItinerary.split(/\n|\|/).map(x => x.trim()).filter(x => x.length > 0);
                let html = '';
                let currentTitle = "Hành trình";
                let contents = [];
                function flush() {
                    if (contents.length > 0) {
                        html += `
                            <div class="timeline-item">
                                <div class="timeline-card shadow-sm">
                                    <h5 class="fw-bold mb-3 text-primary">${currentTitle}</h5>
                                    <div class="text-muted" style="line-height: 1.8;">
                                        ${contents.join('<br/>')}
                                    </div>
                                </div>
                            </div>`;
                    }
                    contents = [];
                }
                rawLines.forEach(line => {
                    let lower = line.toLowerCase();
                    if (lower.startsWith('ngày') || lower.startsWith('day')) {
                        flush();
                        currentTitle = line;
                    } else {
                        contents.push(line);
                    }
                });
                flush(); // flush remaining content
                if (html === '') {
                    // Fallback: display everything as a single block
                    html = `
                        <div class="timeline-item">
                            <div class="timeline-card shadow-sm">
                                <div class="text-muted" style="line-height: 1.8;">
                                    ${rawLines.join('<br/>')}
                                </div>
                            </div>
                        </div>`;
                }

                container.innerHTML = html;
            }

            // Function to update overall rating dynamically
            function updateOverallRating() {
                let cleanliness = parseInt(document.getElementById('cleanlinessInput')?.value) || 5;
                let comfort = parseInt(document.getElementById('comfortInput')?.value) || 5;
                let amenities = parseInt(document.getElementById('amenitiesInput')?.value) || 5;
                let value = parseInt(document.getElementById('valueInput')?.value) || 5;
                
                let average = (cleanliness + comfort + amenities + value) / 4.0;
                let rounded = Math.round(average);
                
                let ratingInput = document.getElementById('ratingInput');
                if (ratingInput) {
                    ratingInput.value = rounded;
                }
                
                // Update star UI for overall rating
                let ratingPicker = document.querySelector('.star-picker[data-target="ratingInput"]');
                if (ratingPicker) {
                    let stars = ratingPicker.querySelectorAll('.star-item');
                    stars.forEach(function(star) {
                        let starVal = parseInt(star.getAttribute('data-val'));
                        if (starVal <= rounded) {
                            star.classList.remove('bi-star', 'text-muted');
                            star.classList.add('bi-star-fill', 'text-warning');
                        } else {
                            star.classList.remove('bi-star-fill', 'text-warning');
                            star.classList.add('bi-star', 'text-muted');
                        }
                    });
                }

                // Update text display of average rating
                let avgDisplay = document.getElementById('overallRatingValue');
                if (avgDisplay) {
                    avgDisplay.textContent = average.toFixed(1) + ' / 5.0';
                }
            }

            // Interactive Star Pickers
            document.querySelectorAll('.star-picker').forEach(function(picker) {
                let targetId = picker.getAttribute('data-target');
                let targetInput = document.getElementById(targetId);
                let stars = picker.querySelectorAll('.star-item');

                function setStars(val) {
                    stars.forEach(function(star) {
                        let starVal = parseInt(star.getAttribute('data-val'));
                        if (starVal <= val) {
                            star.classList.remove('bi-star', 'text-muted');
                            star.classList.add('bi-star-fill', 'text-warning');
                        } else {
                            star.classList.remove('bi-star-fill', 'text-warning');
                            star.classList.add('bi-star', 'text-muted');
                        }
                    });
                }

                // Skip click registration for overall rating
                if (targetId === 'ratingInput') {
                    return;
                }

                stars.forEach(function(star) {
                    star.addEventListener('click', function() {
                        let val = parseInt(this.getAttribute('data-val'));
                        if (targetInput) targetInput.value = val;
                        setStars(val);
                        updateOverallRating();
                    });
                });
            });

        });
    </script>
}
