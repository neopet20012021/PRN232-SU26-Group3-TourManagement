                </div>
                <!-- Tour 3 -->
                <div class="col-md-4">
                    <div class="tour-card h-100">
                        <img src="https://images.unsplash.com/photo-1569420015509-5a507db41e73?auto=format&fit=crop&q=80&w=2070">
                        <div class="p-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-primary bg-opacity-10 text-primary">Đà Nẵng</span>
                                <span class="text-warning fw-bold">★ 4.8</span>
                            </div>
                            <h5 class="fw-bold mb-3">Tour Khám Phá Đà Nẵng - Hội An - Bà Nà Hills</h5>
                            <div class="d-flex justify-content-between align-items-end">
                                <div>
                                    <small class="text-muted d-block">Giá từ</small>
                                    <strong class="fs-5 text-danger">3,800,000 VND</strong>
                                </div>
                                <button class="btn btn-outline-primary btn-sm rounded-pill px-3">Chi tiết</button>
                            </div>
