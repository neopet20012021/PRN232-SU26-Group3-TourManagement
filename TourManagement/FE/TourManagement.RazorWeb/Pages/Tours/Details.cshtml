@page
@model TourManagement.RazorWeb.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

<style>
    body {
        background-color: var(--color-bg-body, #f8fafc);
    }
    
    .hero-banner {
        position: relative;
        height: 400px;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 1.5rem;
    }
    
    .hero-banner img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .tour-header {
        margin-bottom: 2rem;
    }

    .badge-premium {
        background: var(--color-primary-light, #e0f2fe);
        color: var(--color-primary, #0284c7);
        border: 1px solid #bae6fd;
    }

    .tour-title {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 2.5rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 1rem;
    }

    .info-card {
        background: #fff;
        border-radius: 12px;
        padding: 1.5rem;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        height: 100%;
    }
    
    .info-icon-wrapper {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: var(--color-primary-light, #e0f2fe);
        color: var(--color-primary, #0284c7);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .section-title {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 700;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .overview-text {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #475569;
    }

    /* Timeline */
    .timeline {
        position: relative;
        padding-left: 2rem;
        margin-bottom: 0;
    }
    .timeline::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #e2e8f0;
    }
    .timeline-item {
        position: relative;
        margin-bottom: 1.5rem;
    }
    .timeline-item:last-child {
        margin-bottom: 0;
    }
    .timeline-item::before {
        content: '';
        position: absolute;
        left: -2.35rem;
        top: 0.25rem;
        width: 1rem;
        height: 1rem;
        border-radius: 50%;
        background: var(--color-primary, #0284c7);
        border: 3px solid #e0f2fe;
    }
    .timeline-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.25rem;
    }

    /* Checklists */
    .checklist {
        list-style: none;
        padding: 0;
    }
    .checklist li {
        position: relative;
        padding-left: 2rem;
        margin-bottom: 0.75rem;
        line-height: 1.5;
        color: #475569;
    }
    .checklist.included li::before {
        content: '\F26E'; /* bi-check-circle-fill */
        font-family: 'bootstrap-icons';
        position: absolute;
        left: 0;
        top: 0;
        color: #16a34a;
        font-size: 1.1rem;
    }
    .checklist.excluded li::before {
        content: '\F623'; /* bi-x-circle-fill */
        font-family: 'bootstrap-icons';
        position: absolute;
        left: 0;
        top: 0;
        color: #dc2626;
        font-size: 1.1rem;
    }

    /* Sticky Sidebar */
    .booking-sidebar {
        position: sticky;
        top: 2rem;
        background: #fff;
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1);
        border: 1px solid #e2e8f0;
    }

    .price-display {
        font-size: 2rem;
        font-weight: 800;
        color: var(--color-accent, #ea580c);
    }

    /* Related Tours */
    .tour-card {
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
        background: #fff;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .tour-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
    .tour-card img {
        height: 200px;
        width: 100%;
        object-fit: cover;
    }

    /* Reviews */
    .review-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.5rem;
        height: 100%;
    }
    .avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
    }

    /* CTA Section */
    .cta-section {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: white;
        padding: 4rem 0;
        border-radius: 24px;
        margin-top: 4rem;
        text-align: center;
    }
</style>

@if (Model.Schedule == null || Model.Schedule.Tour == null)
{
    <div class="container mt-5">
        <div class="alert alert-danger shadow-sm rounded-3"><i class="bi bi-exclamation-triangle-fill"></i> Tour not found.</div>
    </div>
}
else
{
    <div class="container py-4">
        
        <!-- HERO IMAGE -->
        <div class="hero-banner shadow-sm">
            <img src="@(string.IsNullOrEmpty(Model.Schedule.Tour.Image) ? "https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&q=80&w=2070" : Model.Schedule.Tour.Image)" alt="@Model.Schedule.Tour.TourName">
        </div>

        <!-- TOUR HEADER (BELOW IMAGE) -->
        <div class="tour-header">
            <div class="d-flex gap-2 mb-3 flex-wrap">
                <span class="badge badge-premium px-3 py-2 rounded-pill"><i class="bi bi-star-fill text-warning"></i> 4.8 (120 Đánh giá)</span>
                <span class="badge badge-premium px-3 py-2 rounded-pill"><i class="bi bi-shield-check text-success"></i> Hủy miễn phí</span>
                <span class="badge badge-premium px-3 py-2 rounded-pill"><i class="bi bi-lightning-charge-fill text-warning"></i> Xác nhận ngay</span>
                <span class="badge bg-danger px-3 py-2 rounded-pill fw-bold"><i class="bi bi-fire"></i> Bán Chạy Nhất</span>
            </div>
            <h1 class="tour-title">@Model.Schedule.Tour.TourName</h1>
            <div class="d-flex flex-wrap gap-4 text-muted fw-medium fs-5">
                <span><i class="bi bi-geo-alt-fill text-danger"></i> @Model.Schedule.Tour.Destination</span>
                <span><i class="bi bi-clock-fill text-info"></i> @Model.Schedule.Tour.Days Ngày @Model.Schedule.Tour.Nights Đêm</span>
                <span><i class="bi bi-calendar-event text-primary"></i> @Model.Schedule.StartDate.ToString("dd/MM/yyyy")</span>
            </div>
        </div>

        <div class="row g-4">
            <!-- MAIN CONTENT (LEFT) -->
            <div class="col-lg-8">
                
                <!-- QUICK INFORMATION -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="info-card text-center">
                            <div class="info-icon-wrapper mx-auto"><i class="bi bi-map"></i></div>
                            <small class="text-muted d-block mb-1">Điểm đến</small>
                            <strong class="text-dark">@Model.Schedule.Tour.Destination</strong>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="info-card text-center">
                            <div class="info-icon-wrapper mx-auto"><i class="bi bi-stopwatch"></i></div>
                            <small class="text-muted d-block mb-1">Thời lượng</small>
                            <strong class="text-dark">@Model.Schedule.Tour.Days Ngày @Model.Schedule.Tour.Nights Đêm</strong>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="info-card text-center">
                            <div class="info-icon-wrapper mx-auto"><i class="bi bi-bus-front"></i></div>
                            <small class="text-muted d-block mb-1">Phương tiện</small>
                            <strong class="text-dark">Xe khách / Máy bay</strong>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="info-card text-center">
                            <div class="info-icon-wrapper mx-auto"><i class="bi bi-globe"></i></div>
                            <small class="text-muted d-block mb-1">Ngôn ngữ</small>
                            <strong class="text-dark">Tiếng Việt / English</strong>
                        </div>
                    </div>
                </div>

                <!-- OVERVIEW -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4 p-md-5">
                        <h4 class="section-title"><i class="bi bi-card-text text-primary"></i> Tổng Quan Hành Trình</h4>
                        <div class="overview-text">
                            @Html.Raw(Model.Schedule.Tour.Description?.Replace("\n", "<br/>"))
