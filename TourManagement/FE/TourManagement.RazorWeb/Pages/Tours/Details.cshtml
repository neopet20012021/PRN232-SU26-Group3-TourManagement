                    </div>
                </div>
            </div>
        </div>

        <!-- CTA SECTION -->
        <div class="cta-section shadow">
            <h2 class="fw-bold mb-3" style="font-family: 'Plus Jakarta Sans', sans-serif;">Sẵn sàng khám phá @Model.Schedule.Tour.Destination?</h2>
            <p class="fs-5 opacity-75 mb-4">Hàng ngàn khách hàng đã trải nghiệm và hài lòng. Đừng bỏ lỡ cơ hội này!</p>
            <a href="/Tours/Book?scheduleId=@Model.Schedule.ScheduleId" class="btn btn-light btn-lg px-5 py-3 rounded-pill fw-bold text-primary shadow-lg" style="font-size: 1.2rem;">
                Đặt Tour Này Ngay <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>

    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Parse Included Services
            let rawIncluded = document.getElementById('rawIncluded')?.innerText;
            if(rawIncluded) {
                let items = rawIncluded.split('\n').map(x => x.trim()).filter(x => x.length > 0);
                document.getElementById('includedList').innerHTML = items.map(x => `<li>${x}</li>`).join('');
            }

            // Parse Excluded Services
            let rawExcluded = document.getElementById('rawExcluded')?.innerText;
            if(rawExcluded) {
                let items = rawExcluded.split('\n').map(x => x.trim()).filter(x => x.length > 0);
                document.getElementById('excludedList').innerHTML = items.map(x => `<li>${x}</li>`).join('');
            }

            // Parse Itinerary into Timeline
            let rawItinerary = document.getElementById('rawItinerary')?.innerText;
            let container = document.getElementById('itineraryContainer');
            if(rawItinerary && container) {
                let lines = rawItinerary.split('\n').map(x => x.trim()).filter(x => x.length > 0);
                let html = '';
                
                // Simple parser: group by Day or paragraphs
                let currentTitle = "Hành trình";
                let contents = [];

                function flush() {
                    if(contents.length > 0) {
                        html += `
                            <div class="timeline-item">
                                <div class="timeline-card shadow-sm">
                                    <h5 class="fw-bold mb-3 text-primary">${currentTitle}</h5>
                                    <div class="text-muted" style="line-height: 1.8;">
                                        ${contents.join('<br/>')}
                                    </div>
                                </div>
                            </div>
                        `;
                    }
                    contents = [];
                }

                lines.forEach(line => {
                    let lower = line.toLowerCase();
                    // If line starts with "Ngày", "Day", "Đêm" - consider it a title
                    if(lower.startsWith('ngày') || lower.startsWith('day')) {
                        flush();
                        currentTitle = line;
                    } else {
                        contents.push(line);
                    }
                });
                flush(); // flush the last block

                // If parsing resulted in no "Day" blocks, just output as one block
                if(html === '') {
                     html = `
                        <div class="timeline-item">
                            <div class="timeline-card shadow-sm">
                                <div class="text-muted" style="line-height: 1.8;">
                                    ${lines.join('<br/>')}
                                </div>
                            </div>
                        </div>
                    `;
                }

                container.innerHTML = html;
            }
        });
    </script>
}
