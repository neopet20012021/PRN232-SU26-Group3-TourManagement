        </div>

        <!-- RELATED TOURS (MOCK) -->
        <div class="mt-5 pt-4">
            <h3 class="fw-bold mb-4" style="font-family: 'Plus Jakarta Sans', sans-serif;">Có Thể Bạn Sẽ Thích</h3>
            <div class="row g-4">
                <!-- Tour 1 -->
                <div class="col-md-4">
                    <div class="tour-card h-100">
                        <img src="https://images.unsplash.com/photo-1583417319070-4a69db38a482?auto=format&fit=crop&q=80&w=2070">
                        <div class="p-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-primary bg-opacity-10 text-primary">Sapa</span>
                                <span class="text-warning fw-bold">★ 4.9</span>
                            </div>
                            <h5 class="fw-bold mb-3">Tour Sapa Mù Cang Chải Nổi Bật 3 Ngày 2 Đêm</h5>
                            <div class="d-flex justify-content-between align-items-end">
