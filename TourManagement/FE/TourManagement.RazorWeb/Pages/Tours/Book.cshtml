@page
@model TourManagement.RazorWeb.Pages.Tours.BookModel
@{
    ViewData["Title"] = "Book Tour";
}

@if (Model.Schedule == null || Model.Schedule.Tour == null)
{
    <div class="alert alert-danger">Tour not found.</div>
}
else
{
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body d-flex align-items-center gap-3">
                    <img src="@(string.IsNullOrEmpty(Model.Schedule.Tour.Image) ? "https://via.placeholder.com/150" : Model.Schedule.Tour.Image)" class="rounded" style="width: 100px; height: 100px; object-fit: cover;">
                    <div>
                        <h5 class="mb-1 fw-bold">@Model.Schedule.Tour.TourName</h5>
                        <p class="mb-0 text-muted"><i class="bi bi-calendar-event"></i> Departure: @Model.Schedule.StartDate.ToString("dd/MM/yyyy")</p>
                    </div>
                </div>
            </div>

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h3 class="card-title fw-bold text-primary text-center mb-4">Complete Your Booking</h3>
                    
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div class="alert alert-success text-center">
                            <h4><i class="bi bi-check-circle-fill text-success"></i></h4>
                            @Model.SuccessMessage
                            <br/><br/>
                            <a href="/MyBookings" class="btn btn-primary">View My Bookings</a>
                        </div>
                    }
                    else if (Model.Schedule.AvailableSeats > 0)
                    {
                        <!-- Wizard Progress -->
                        <div class="d-flex justify-content-between mb-5 position-relative">
                            <div class="progress position-absolute top-50 start-0 w-100 translate-middle-y" style="height: 3px; z-index: 0;">
                                <div id="wizardProgress" class="progress-bar bg-primary" role="progressbar" style="width: 0%;"></div>
                            </div>
                            <button type="button" class="btn btn-primary rounded-circle position-relative fw-bold step-btn shadow-sm" style="width: 45px; height: 45px; z-index: 1;" data-step="1">1</button>
                            <button type="button" class="btn btn-light border rounded-circle position-relative fw-bold step-btn shadow-sm" style="width: 45px; height: 45px; z-index: 1;" data-step="2">2</button>
                            <button type="button" class="btn btn-light border rounded-circle position-relative fw-bold step-btn shadow-sm" style="width: 45px; height: 45px; z-index: 1;" data-step="3">3</button>
                        </div>

                        <form method="post" id="bookingForm">
                            <input type="hidden" asp-for="BookingInput.ScheduleId" value="@Model.Schedule.ScheduleId" id="scheduleId" />
                            
                            <!-- Step 1: Pax Selection -->
                            <div class="wizard-step" id="step1">
                                <h4 class="mb-4 fw-bold">1. Select Passengers</h4>
                                <div class="row">
                                    <div class="col-sm-4 mb-3">
                                        <label asp-for="BookingInput.AdultCount" class="form-label fw-bold">Người lớn</label>
                                        <div class="text-muted small mb-2">Từ 12 tuổi trở lên</div>
                                        <input asp-for="BookingInput.AdultCount" type="number" min="1" class="form-control form-control-lg pax-input" id="adultCount" required />
                                        <small class="text-danger">@Model.Schedule.ActualAdultPrice.ToString("N0") VND</small>
                                    </div>
                                    <div class="col-sm-4 mb-3">
                                        <label asp-for="BookingInput.ChildCount" class="form-label fw-bold">Trẻ em</label>
                                        <div class="text-muted small mb-2">Từ 2 - 11 tuổi</div>
                                        <input asp-for="BookingInput.ChildCount" type="number" min="0" class="form-control form-control-lg pax-input" id="childCount" required />
                                        <small class="text-danger">@Model.Schedule.ActualChildPrice.ToString("N0") VND</small>
                                    </div>
                                    <div class="col-sm-4 mb-3">
                                        <label asp-for="BookingInput.InfantCount" class="form-label fw-bold">Em bé</label>
                                        <div class="text-muted small mb-2">Dưới 2 tuổi</div>
                                        <input asp-for="BookingInput.InfantCount" type="number" min="0" class="form-control form-control-lg pax-input" id="infantCount" />
                                        <small class="text-success">Free</small>
                                    </div>
                                </div>
                                <div class="mb-4 mt-3">
                                    <label asp-for="BookingInput.PromoCode" class="form-label text-muted">Promo Code (Optional)</label>
                                    <div class="input-group input-group-lg">
                                        <input asp-for="BookingInput.PromoCode" class="form-control" id="promoCode" placeholder="Enter code here..." />
                                        <button class="btn btn-outline-primary" type="button" id="applyPromoBtn">Apply</button>
                                    </div>
                                </div>

                                <div class="bg-light p-4 rounded-4 mb-4 text-center border">
                                    <span class="text-muted d-block mb-1">Total Price</span>
                                    <span class="fw-bold display-6 text-danger" id="totalPriceDisplay">@Model.Schedule.ActualAdultPrice.ToString("N0") VND</span>
                                </div>

                                <button type="button" class="btn btn-primary w-100 btn-lg rounded-pill shadow" onclick="nextStep(2)">Next: Contact Information <i class="bi bi-arrow-right"></i></button>
                            </div>
                            
                            <!-- Step 2: Contact Info -->
                            <div class="wizard-step d-none" id="step2">
                                <h4 class="mb-4 fw-bold">2. Contact Information</h4>
                                @if (!User.Identity.IsAuthenticated)
                                {
                                    <div class="alert alert-info py-3 rounded-3 border-0"><i class="bi bi-info-circle-fill"></i> You are booking as a Guest. <a href="/Login" class="fw-bold">Login</a> to auto-fill your details.</div>
                                }
                                <div class="mb-3">
                                    <label asp-for="BookingInput.CustomerName" class="form-label fw-bold">Full Name</label>
                                    <input asp-for="BookingInput.CustomerName" class="form-control form-control-lg" placeholder="John Doe" required />
                                    <span asp-validation-for="BookingInput.CustomerName" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="BookingInput.PhoneNumber" class="form-label fw-bold">Phone Number</label>
                                    <input asp-for="BookingInput.PhoneNumber" class="form-control form-control-lg" placeholder="09xxxxxxxxx" required />
                                    <span asp-validation-for="BookingInput.PhoneNumber" class="text-danger"></span>
                                </div>
                                <div class="mb-4">
                                    <label asp-for="BookingInput.Email" class="form-label fw-bold">Email Address</label>
                                    <input asp-for="BookingInput.Email" type="email" class="form-control form-control-lg" placeholder="example@email.com" required />
                                    <span asp-validation-for="BookingInput.Email" class="text-danger"></span>
                                </div>
                                <div class="d-flex justify-content-between gap-3 mt-5">
                                    <button type="button" class="btn btn-light border btn-lg rounded-pill px-4" onclick="nextStep(1)">Back</button>
                                    <button type="button" class="btn btn-primary btn-lg rounded-pill px-5 shadow flex-grow-1" onclick="nextStep(3)">Next: Payment <i class="bi bi-arrow-right"></i></button>
                                </div>
                            </div>

                            <!-- Step 3: Payment -->
                            <div class="wizard-step d-none" id="step3">
                                <h4 class="mb-4 fw-bold">3. Payment & Confirm</h4>
                                <div class="mb-4">
                                    <label asp-for="BookingInput.PaymentMethod" class="form-label fw-bold">Select Payment Method</label>
                                    <select asp-for="BookingInput.PaymentMethod" class="form-select form-select-lg" required>
                                        <option value="">-- Choose Method --</option>
                                        <option value="Cash">Cash at Office</option>
                                        <option value="BankTransfer">Bank Transfer</option>
                                        <option value="CreditCard">Credit Card</option>
                                    </select>
                                    <span asp-validation-for="BookingInput.PaymentMethod" class="text-danger"></span>
                                </div>
                                
                                <div class="mb-4">
                                    <label asp-for="BookingInput.SpecialRequest" class="form-label fw-bold">Special Request (Optional)</label>
                                    <textarea asp-for="BookingInput.SpecialRequest" class="form-control" rows="3" placeholder="Any dietary requirements or special needs?"></textarea>
                                </div>

                                <div class="alert alert-warning mb-4 rounded-3 border-0">
                                    <i class="bi bi-exclamation-triangle-fill text-warning"></i> By clicking confirm, you agree to our Terms and Conditions regarding cancellation and refunds.
                                </div>

                                <div class="d-flex justify-content-between gap-3 mt-4">
                                    <button type="button" class="btn btn-light border btn-lg rounded-pill px-4" onclick="nextStep(2)">Back</button>
                                    <button type="submit" class="btn btn-success btn-lg rounded-pill shadow flex-grow-1 fw-bold"><i class="bi bi-check-circle"></i> Confirm Booking</button>
                                </div>
                            </div>

                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning p-4 text-center rounded-3">
                            <h4><i class="bi bi-emoji-frown"></i> Fully Booked</h4>
                            <p class="mb-0 mt-2">We are sorry, but this tour has no available seats left.</p>
                            <a href="/Index" class="btn btn-primary mt-3">Find Other Tours</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function nextStep(step) {
            // Validation check before going to next step
            if (step > 1) {
                let currentStep = step - 1;
                let inputs = document.querySelectorAll('#step' + currentStep + ' input[required], #step' + currentStep + ' select[required]');
                let valid = true;
                inputs.forEach(input => {
                    if (!input.checkValidity()) {
                        input.reportValidity();
                        valid = false;
                    }
                });
                if (!valid) return;
            }

            document.querySelectorAll('.wizard-step').forEach(el => el.classList.add('d-none'));
            document.getElementById('step' + step).classList.remove('d-none');
            
            // Update progress bar
            let progress = (step - 1) * 50;
            document.getElementById('wizardProgress').style.width = progress + '%';
            
            // Update step buttons
            document.querySelectorAll('.step-btn').forEach(btn => {
                let btnStep = parseInt(btn.getAttribute('data-step'));
                if (btnStep <= step) {
                    btn.classList.remove('btn-light', 'border', 'text-dark');
                    btn.classList.add('btn-primary', 'text-white');
                } else {
                    btn.classList.add('btn-light', 'border', 'text-dark');
                    btn.classList.remove('btn-primary', 'text-white');
                }
            });
        }

        const priceAdult = @(Model.Schedule?.ActualAdultPrice ?? 0);
        const priceChild = @(Model.Schedule?.ActualChildPrice ?? 0);

        async function updatePrice() {
            let adult = parseInt(document.getElementById('adultCount').value) || 0;
            let child = parseInt(document.getElementById('childCount').value) || 0;
            let promoCode = document.getElementById('promoCode').value;
            let scheduleId = document.getElementById('scheduleId').value;
            let token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            try {
                let response = await fetch('?handler=CalculatePrice', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        ScheduleId: parseInt(scheduleId),
                        AdultCount: adult,
                        ChildCount: child,
                        PromoCode: promoCode
                    })
                });

                if (response.ok) {
                    let result = await response.json();
                    if (result.success && result.data) {
                        let finalPrice = result.data.finalPrice;
                        let text = finalPrice.toLocaleString('vi-VN') + " VND";
                        if (result.data.appliedPromoCode) {
                            text += " (Đã áp dụng mã giảm giá)";
                        }
                        document.getElementById('totalPriceDisplay').innerText = text;
                        return;
                    }
                }
            } catch (error) {
                console.error("Error calculating price:", error);
            }

            // Fallback
            let total = (adult * priceAdult) + (child * priceChild);
            document.getElementById('totalPriceDisplay').innerText = total.toLocaleString('vi-VN') + " VND";
        }

        document.querySelectorAll('.pax-input').forEach(el => el.addEventListener('change', updatePrice));
        document.getElementById('applyPromoBtn')?.addEventListener('click', function() {
            let code = document.getElementById('promoCode').value;
            if(!code) return;
            
            alert('Đang kiểm tra mã giảm giá...');
            updatePrice(); 
        });
    </script>
}
