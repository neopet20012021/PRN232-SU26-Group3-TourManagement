@page
@model TourManagement.RazorWeb.Pages.MyBookingsModel
@{
    ViewData["Title"] = "My Bookings";
}

<div class="mb-4">
    <h2>My Bookings</h2>
    <p class="text-muted">Here are all the tours you have booked with us.</p>
</div>

@if (Model.Bookings.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Booking Code</th>
                <th>Tour Name</th>
                <th>Booking Date</th>
                <th>Departure Date</th>
                <th>Adults</th>
                <th>Children</th>
                <th>Total Price</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model.Bookings)
            {
                <tr>
                    <td><strong>@booking.BookingCode</strong></td>
                    <td>@(booking.Schedule?.Tour?.TourName ?? "N/A")</td>
                    <td>@booking.BookingDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@(booking.Schedule?.StartDate.ToString("dd/MM/yyyy") ?? "N/A")</td>
                    <td>@booking.AdultCount</td>
                    <td>@booking.ChildCount</td>
                    <td class="text-primary fw-bold">@booking.TotalPrice.ToString("N0") VND</td>
                    <td>
                        @{
                            var badgeClass = booking.Status.ToLower() switch
                            {
                                "pending" => "bg-warning text-dark",
                                "confirmed" => "bg-success",
                                "cancelled" => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@booking.Status.ToUpper()</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        You haven't booked any tours yet. <a href="/">Explore our tours</a> and start your adventure!
    </div>
}
