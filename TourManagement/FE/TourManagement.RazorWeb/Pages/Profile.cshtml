@page
@model TourManagement.RazorWeb.Pages.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="bg-primary p-4 text-center text-white">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-white text-primary rounded-circle shadow" style="width: 100px; height: 100px; font-size: 2.5rem;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                </div>
                <h2 class="fw-bold mb-0">@Model.FullName</h2>
                <p class="mb-0 fs-5"><span class="badge bg-light text-primary">@Model.Role</span></p>
            </div>
            
            <div class="card-body p-5">
                <div class="row mb-5">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <div class="d-flex align-items-center">
                            <div class="fs-1 text-muted me-3"><i class="bi bi-envelope"></i></div>
                            <div>
                                <h6 class="text-muted mb-1 text-uppercase fw-bold" style="font-size: 0.85rem;">Email Address</h6>
                                <p class="fs-5 mb-0 fw-semibold">@Model.Email</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-center">
                            <div class="fs-1 text-muted me-3"><i class="bi bi-person-badge"></i></div>
                            <div>
                                <h6 class="text-muted mb-1 text-uppercase fw-bold" style="font-size: 0.85rem;">Username</h6>
                                <p class="fs-5 mb-0 fw-semibold">@Model.Username</p>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="mb-5 border-2 text-primary" style="opacity: 0.1;">

                <h4 class="fw-bold text-dark mb-4"><i class="bi bi-bar-chart-fill text-primary"></i> Booking Statistics</h4>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="card bg-light border-0 shadow-sm rounded-3 h-100">
                            <div class="card-body text-center p-4">
                                <div class="fs-1 text-success mb-2"><i class="bi bi-cash-stack"></i></div>
                                <h6 class="text-muted text-uppercase fw-bold">Total Spent</h6>
                                <h2 class="text-danger fw-bold mb-0">@Model.TotalSpent.ToString("N0") VND</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="card bg-light border-0 shadow-sm rounded-3 h-100">
                            <div class="card-body text-center p-4">
                                <div class="fs-1 text-primary mb-2"><i class="bi bi-journal-check"></i></div>
                                <h6 class="text-muted text-uppercase fw-bold">Tours Booked</h6>
                                <h2 class="text-dark fw-bold mb-0">@Model.TotalToursBooked</h2>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-5">
                    <a href="/MyBookings" class="btn btn-outline-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">View Booking History</a>
                </div>
            </div>
        </div>
    </div>
</div>
