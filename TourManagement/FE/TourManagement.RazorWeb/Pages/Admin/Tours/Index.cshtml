@page
@model TourManagement.RazorWeb.Pages.Admin.Tours.IndexModel
@{
    ViewData["Title"] = "Quản Lý Tour";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark m-0">Quản Lý Danh Sách Tour</h3>
    @if (User.IsInRole("Admin"))
    {
        <a href="/Admin/Tours/Create" class="btn btn-primary px-4 rounded-pill fw-semibold shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Thêm Tour Mới
        </a>
    }
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-white bg-opacity-25 p-3 rounded-3 me-3">
                    <i class="bi bi-map fs-3"></i>
                </div>
                <div>
                    <h6 class="mb-0 text-white-50">Tổng Số Tour</h6>
                    <h3 class="mb-0 fw-bold">@Model.TotalTours</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-white bg-opacity-25 p-3 rounded-3 me-3">
                    <i class="bi bi-check-circle fs-3"></i>
                </div>
                <div>
                    <h6 class="mb-0 text-white-50">Đang Hoạt Động</h6>
                    <h3 class="mb-0 fw-bold">@Model.ActiveTours</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-secondary text-white border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-white bg-opacity-25 p-3 rounded-3 me-3">
                    <i class="bi bi-x-circle fs-3"></i>
                </div>
                <div>
                    <h6 class="mb-0 text-white-50">Đã Đóng</h6>
                    <h3 class="mb-0 fw-bold">@Model.InactiveTours</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search Filter -->
<div class="card admin-card mb-4 border-0 shadow-sm">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" asp-for="SearchQuery" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm theo mã tour, tên tour hoặc điểm đến..." />
                </div>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">Lọc</button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <a href="/Admin/Tours/Index" class="btn btn-outline-secondary w-100">Xóa</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card admin-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-table me-2"></i> Danh sách tất cả các Tour</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mã Code</th>
                        <th>Tên Tour</th>
                        <th>Điểm Đến</th>
                        <th>Thời Gian</th>
                        <th>Giá (Người Lớn)</th>
                        <th>Tổng Số Chỗ</th>
                        <th>Trạng Thái</th>
                        <th class="text-center pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tour in Model.Tours)
                    {
                        <tr>
                            <td class="ps-4"><span class="badge bg-light text-dark border">@tour.TourCode</span></td>
                            <td style="max-width: 250px;" class="text-truncate fw-semibold text-primary" title="@tour.TourName">@tour.TourName</td>
                            <td><i class="bi bi-geo-alt-fill text-danger me-1"></i> @tour.Destination</td>
                            <td>@tour.Days N / @tour.Nights Đ</td>
                            <td class="text-danger fw-bold">@tour.PricePerAdult.ToString("N0") <small>đ</small></td>
                            <td>
                                @tour.MaxCapacity
                            </td>
                            <td>
                                @if (tour.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">Đã đóng</span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                @if (User.IsInRole("Admin"))
                                {
                                    <a href="/Admin/Tours/Edit?id=@tour.TourId" class="btn btn-sm btn-light text-primary shadow-sm border" title="Chỉnh sửa"><i class="bi bi-pencil"></i></a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@tour.TourId" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tour này không?');">
                                        <button type="submit" class="btn btn-sm btn-light text-danger shadow-sm border" title="Xóa"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Chỉ xem</span>
                                }
                            </td>
                        </tr>
                    }
                    @if(!Model.Tours.Any()) {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Chưa có dữ liệu tour nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
