@page
@model TourManagement.RazorWeb.Pages.Admin.Bookings.IndexModel
@{
    ViewData["Title"] = "Quản Lý Đặt Chỗ";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark m-0">Quản Lý Đơn Đặt Chỗ</h3>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-white bg-opacity-25 p-3 rounded-3 me-3">
                    <i class="bi bi-card-list fs-3"></i>
                </div>
                <div>
                    <h6 class="mb-0 text-white-50">Tổng Đơn Đặt Chỗ</h6>
                    <h3 class="mb-0 fw-bold">@Model.TotalBookings</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-warning text-dark border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-white bg-opacity-50 p-3 rounded-3 me-3">
                    <i class="bi bi-hourglass-split fs-3"></i>
                </div>
                <div>
                    <h6 class="mb-0 text-dark-50">Chờ Xử Lý</h6>
                    <h3 class="mb-0 fw-bold">@Model.PendingBookings</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-white bg-opacity-25 p-3 rounded-3 me-3">
                    <i class="bi bi-cash-coin fs-3"></i>
                </div>
                <div>
                    <h6 class="mb-0 text-white-50">Tổng Doanh Thu</h6>
                    <h3 class="mb-0 fw-bold">@Model.TotalRevenue.ToString("N0") đ</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search Filter -->
<div class="card admin-card mb-4 border-0 shadow-sm">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" asp-for="SearchQuery" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm theo mã đặt chỗ, tên khách hàng, số điện thoại..." />
                </div>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">Lọc</button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <a href="/Admin/Bookings/Index" class="btn btn-outline-secondary w-100">Xóa</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card admin-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-card-list me-2"></i> Danh sách tất cả các đơn đặt chỗ</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mã Đặt Chỗ</th>
                        <th>Khách Hàng</th>
                        <th>Tour</th>
                        <th>Số Lượng Khách</th>
                        <th>Tổng Tiền</th>
                        <th>Trạng Thái</th>
                        <th>Ngày Đặt</th>
                        <th class="text-center pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model.Bookings)
                    {
                        <tr>
                            <td class="ps-4"><span class="badge bg-light text-dark border">@booking.BookingCode</span></td>
                            <td>
                                <span class="fw-semibold text-dark">@booking.CustomerName</span><br/>
                                <small class="text-muted"><i class="bi bi-telephone-fill me-1"></i> @booking.PhoneNumber</small>
                            </td>
                            <td style="max-width: 200px;" class="text-truncate text-primary" title="@booking.Schedule?.Tour?.TourName">
                                @booking.Schedule?.Tour?.TourName
                            </td>
                            <td><i class="bi bi-people-fill text-muted me-1"></i> @(booking.AdultCount + booking.ChildCount + booking.InfantCount) khách</td>
                            <td class="text-danger fw-bold">@booking.TotalPrice.ToString("N0") <small>đ</small></td>
                            <td>
                                @if (booking.Status.ToLower() == "pending")
                                {
                                    <span class="badge bg-warning text-dark border border-warning px-2 py-1">Chờ Xử Lý</span>
                                }
                                else if (booking.Status.ToLower() == "paid" || booking.Status.ToLower() == "confirmed")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Đã Thanh Toán</span>
                                }
                                else if (booking.Status.ToLower() == "cancelled")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">Đã Hủy</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-2 py-1">@booking.Status</span>
                                }
                            </td>
                            <td class="text-muted small">@booking.BookingDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center pe-4">
                                <a href="/Admin/Bookings/Details?id=@booking.BookingId" class="btn btn-sm @(User.IsInRole("Admin") ? "btn-light text-primary border" : "btn-primary") rounded-pill px-3 shadow-sm">
                                    @(User.IsInRole("Admin") ? "Xem chi tiết" : "Xử lý") <i class="bi bi-arrow-right-short"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if(!Model.Bookings.Any()) {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Chưa có đơn đặt chỗ nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
