@page
@model TourManagement.RazorWeb.Pages.Admin.Bookings.DetailsModel
@{
    ViewData["Title"] = "Xử Lý Đặt Chỗ";
}

<div class="mb-4">
    <a href="/Admin/Bookings/Index" class="btn btn-light shadow-sm border"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
</div>

@if (Model.Booking == null)
{
    <div class="alert alert-danger shadow-sm border-0"><i class="bi bi-exclamation-triangle-fill me-2"></i> Không tìm thấy đơn đặt chỗ.</div>
}
else
{
    <div class="row g-4">
        <!-- Thông tin chi tiết -->
        <div class="col-lg-8">
            <!-- Thông tin khách hàng -->
            <div class="card admin-card mb-4">
                <div class="card-header">
                    <i class="bi bi-person-lines-fill text-primary me-2"></i> Thông Tin Khách Hàng
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted small mb-1">Họ và Tên</label>
                            <p class="fw-bold mb-0">@Model.Booking.CustomerName</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small mb-1">Số Điện Thoại</label>
                            <p class="fw-semibold mb-0">@Model.Booking.PhoneNumber</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small mb-1">Email</label>
                            <p class="mb-0">@Model.Booking.Email</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small mb-1">Ngày Giờ Đặt</label>
                            <p class="mb-0">@Model.Booking.BookingDate.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thông tin Tour -->
            <div class="card admin-card mb-4">
                <div class="card-header">
                    <i class="bi bi-map-fill text-success me-2"></i> Thông Tin Lịch Trình
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="text-muted small mb-1">Tên Tour</label>
                            <p class="fw-bold text-primary mb-0">@Model.Booking.Schedule?.Tour?.TourName</p>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small mb-1">Ngày Khởi Hành</label>
                            <p class="fw-semibold mb-0">@Model.Booking.Schedule?.StartDate.ToString("dd/MM/yyyy")</p>
                        </div>
                        <div class="col-md-8">
                            <label class="text-muted small mb-1">Cơ Cấu Khách</label>
                            <p class="mb-0">
                                <span class="badge bg-light text-dark border me-1">Người lớn: @Model.Booking.AdultCount</span>
                                <span class="badge bg-light text-dark border me-1">Trẻ em: @Model.Booking.ChildCount</span>
                                <span class="badge bg-light text-dark border">Em bé: @Model.Booking.InfantCount</span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Thông tin thanh toán -->
            <div class="card admin-card">
                <div class="card-header">
                    <i class="bi bi-credit-card-fill text-warning me-2"></i> Thông Tin Thanh Toán
                </div>
                <div class="card-body">
                    <div class="row g-3 align-items-center">
                        <div class="col-sm-6 mb-3">
                            <span class="text-muted d-block small mb-1">Phương thức thanh toán</span>
                            @{
                                var paymentMethod = Model.Booking.Payments?.FirstOrDefault()?.PaymentMethod ?? "N/A";
                            }
                            <p class="fw-semibold mb-0">@paymentMethod</p>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <label class="text-muted small mb-1">Tổng Số Tiền</label>
                            <h3 class="text-danger fw-bold mb-0">@Model.Booking.TotalPrice.ToString("N0") <small class="fs-6 text-muted fw-normal">VND</small></h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bảng điều khiển Xử lý -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 20px; border-top: 5px solid #0d6efd !important;">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-4"><i class="bi bi-gear-fill me-2"></i> Xử Lý Trạng Thái</h5>
                    
                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div class="alert alert-success border-0 shadow-sm py-2 px-3"><i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger border-0 shadow-sm py-2 px-3"><i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage</div>
                    }

                    <div class="mb-4 text-center bg-light p-3 rounded-3 border">
                        <label class="text-muted small d-block mb-2">Trạng Thái Hiện Tại</label>
                        <h4 class="mb-0">
                            @if(Model.Booking.Status.ToLower() == "pending") {
                                <span class="badge bg-warning text-dark border border-warning px-3 py-2 w-100">Chờ Thanh Toán</span>
                            } else if (Model.Booking.Status.ToLower() == "deposited") {
                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-2 w-100">Đã Đặt Cọc</span>
                            } else if (Model.Booking.Status.ToLower() == "paid" || Model.Booking.Status.ToLower() == "confirmed") {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 w-100">Đã Thanh Toán</span>
                            } else if (Model.Booking.Status.ToLower() == "cancelled") {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 w-100">Đã Hủy Bỏ</span>
                            } else {
                                <span class="badge bg-secondary px-3 py-2 w-100">@Model.Booking.Status.ToUpper()</span>
                            }
                        </h4>
                    </div>

                    @if (!User.IsInRole("Admin"))
                    {
                        <form method="post">
                            <input type="hidden" asp-for="BookingId" value="@Model.Booking.BookingId" />
                            <div class="mb-4">
                                <label asp-for="NewStatus" class="form-label fw-semibold">Cập Nhật Trạng Thái Mới</label>
                                <select asp-for="NewStatus" class="form-select border-secondary">
                                    <option value="Pending">Pending (Chờ thanh toán)</option>
                                    <option value="Deposited">Deposited (Đã đặt cọc)</option>
                                    <option value="Paid">Paid (Đã thanh toán đủ)</option>
                                    <option value="Confirmed">Confirmed (Đã xác nhận)</option>
                                    <option value="Cancelled">Cancelled (Hủy bỏ)</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 fw-bold py-2 shadow-sm"><i class="bi bi-arrow-repeat me-1"></i> Lưu Cập Nhật</button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-info border-0 shadow-sm mt-3 mb-0">
                            <i class="bi bi-info-circle-fill me-2"></i> Admin chỉ có quyền xem tổng quan đơn đặt chỗ. Việc xử lý sẽ do Staff phụ trách.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
