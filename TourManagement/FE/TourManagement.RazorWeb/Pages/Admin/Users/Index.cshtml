@page
@model TourManagement.RazorWeb.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Quản Lý User";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark m-0">Quản Lý Người Dùng</h3>
    <a href="/Admin/Users/Create" class="btn btn-primary px-4 rounded-pill fw-semibold shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Thêm Mới
    </a>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-white bg-opacity-25 p-3 rounded-3 me-3">
                    <i class="bi bi-people fs-3"></i>
                </div>
                <div>
                    <h6 class="mb-0 text-white-50">Tổng Người Dùng</h6>
                    <h3 class="mb-0 fw-bold">@Model.TotalUsers</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-danger text-white border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-white bg-opacity-25 p-3 rounded-3 me-3">
                    <i class="bi bi-shield-lock fs-3"></i>
                </div>
                <div>
                    <h6 class="mb-0 text-white-50">Tài Khoản Admin</h6>
                    <h3 class="mb-0 fw-bold">@Model.AdminCount</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-info text-white border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-white bg-opacity-25 p-3 rounded-3 me-3">
                    <i class="bi bi-person-badge fs-3"></i>
                </div>
                <div>
                    <h6 class="mb-0 text-white-50">Nhân Viên (Staff)</h6>
                    <h3 class="mb-0 fw-bold">@Model.StaffCount</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search Filter -->
<div class="card admin-card mb-4 border-0 shadow-sm">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" asp-for="SearchQuery" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm theo họ tên, username hoặc email..." />
                </div>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">Lọc</button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <a href="/Admin/Users/Index" class="btn btn-outline-secondary w-100">Xóa</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card admin-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-people-fill me-2"></i> Danh sách tài khoản hệ thống</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Họ Tên</th>
                        <th>Tên Đăng Nhập</th>
                        <th>Email</th>
                        <th>Vai Trò (Role)</th>
                        <th class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.UsersList != null && Model.UsersList.Any())
                    {
                        foreach (var user in Model.UsersList)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted">#@user.UserId</td>
                                <td class="fw-bold text-dark">@user.FullName</td>
                                <td>@user.Username</td>
                                <td class="text-muted">@user.Email</td>
                                <td>
                                    @if(user.Role == "Admin")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">@user.Role</span>
                                    }
                                    else if(user.Role == "Staff")
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">@user.Role</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2 py-1">@user.Role</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm">
                                        <a href="/Admin/Users/Details?id=@user.UserId" class="btn btn-sm btn-light border text-info" title="Chi tiết"><i class="bi bi-eye"></i></a>
                                        <a href="/Admin/Users/Edit?id=@user.UserId" class="btn btn-sm btn-light border text-primary" title="Sửa"><i class="bi bi-pencil"></i></a>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@user.UserId" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa user này không?');">
                                            <button type="submit" class="btn btn-sm btn-light border text-danger" @(user.Role == "Admin" ? "disabled" : "") title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                Không tìm thấy người dùng nào trong hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
