@page
@model IndexModel
@{
    ViewData["Title"] = "Khám phá Tour du lịch";
}

<style>
    /* Hero Banner Styling */

    /* Hero Banner Styling */
    .hero-banner {
        background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);
        border-radius: 24px;
        padding: 5rem 2rem;
        position: relative;
        overflow: hidden;
        margin-bottom: 4rem;
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    }
    
    .hero-banner::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
        pointer-events: none;
    }
    
    .hero-title {
        font-weight: 700;
        font-size: 3.2rem;
        color: #ffffff;
        letter-spacing: -1px;
        line-height: 1.2;
    }
    
    .hero-subtitle {
        color: rgba(255, 255, 255, 0.8);
        font-size: 1.2rem;
        font-weight: 300;
        margin-bottom: 2rem;
    }

    /* Search Bar in Hero */
    .search-container {
        background: #ffffff;
        border-radius: 24px;
        padding: 6px;
        max-width: 950px;
        margin: 0 auto;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        transition: all 0.3s ease;
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }
    
    .search-container:focus-within {
        box-shadow: 0 15px 40px rgba(0,0,0,0.3);
        transform: translateY(-2px);
    }

    .search-input {
        background: transparent !important;
        border: none !important;
        color: #1e293b !important;
        padding: 10px 20px;
        font-size: 1.05rem;
    }
    
    .search-input::placeholder {
        color: #94a3b8;
    }
    
    .search-input:focus {
        outline: none !important;
        box-shadow: none !important;
        color: #1e293b !important;
        background: transparent !important;
    }

    .search-btn {
        background: var(--color-accent);
        border: none;
        color: white;
        border-radius: 50px;
        padding: 12px 30px;
        font-weight: 600;
        font-size: 1rem;
        box-shadow: 0 5px 15px rgba(249, 115, 22, 0.4);
        transition: all 0.3s ease;
    }
    
    .search-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(234, 88, 12, 0.6);
        background: var(--color-accent-hover);
        color: white;
    }

    /* Info Badges Section */
    .info-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid rgba(0,0,0,0.03);
        padding: 1.5rem;
        transition: all 0.3s ease;
        box-shadow: 0 5px 15px rgba(0,0,0,0.01);
    }
    
    .info-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.05);
    }

    /* Tour Cards Grid */
    .section-title {
        font-size: 2.2rem;
        font-weight: 700;
        color: #1e293b;
        position: relative;
        display: inline-block;
        margin-bottom: 2.5rem;
    }
    
    .section-title::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -8px;
        width: 60px;
        height: 4px;
        background: linear-gradient(90deg, #3b82f6, #06b6d4);
        border-radius: 2px;
    }

    .tour-card {
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        border: none;
        background: #ffffff;
    }
    
    .tour-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08) !important;
    }
    
    .card-img-wrapper {
        overflow: hidden;
        border-radius: 16px 16px 0 0;
        height: 240px;
    }
    
    .tour-img {
        transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .tour-card:hover .tour-img {
        transform: scale(1.08);
    }
    
    .price-tag {
        color: #ef4444;
        font-size: 1.6rem;
        font-weight: 800;
        letter-spacing: -0.5px;
    }
    
    .pax-badge {
        background-color: rgba(239, 68, 68, 0.1);
        color: #ef4444;
        font-weight: 600;
    }
    
    .btn-details {
        background: var(--color-primary);
        border: none;
        color: white;
        transition: all 0.3s ease;
    }
    
    .btn-details:hover {
        background: var(--color-primary-hover);
        box-shadow: 0 4px 15px rgba(2, 132, 199, 0.3);
        color: white;
    }
</style>

<!-- Hero Banner -->
<div class="hero-banner text-center position-relative">
    <div class="position-relative" style="z-index: 2;">
        <h1 class="hero-title mb-2">Tìm Kiếm Hành Trình Trong Mơ</h1>
        <p class="hero-subtitle font-serif">Khám phá thế giới, trải nghiệm văn hóa và lưu giữ những kỷ niệm vô giá cùng chúng tôi.</p>
        
        <!-- Search Form -->
        <form method="get" class="search-container text-start p-2 shadow">
            <div class="d-flex align-items-center">
                <i class="bi bi-search text-muted ms-3 fs-5"></i>
                <input type="text" name="keyword" value="@Model.Keyword" class="form-control search-input flex-grow-1 border-0 fw-medium" placeholder="Bạn muốn đi đâu chơi? Điểm đến, tên tour..." />
                <button type="submit" class="btn search-btn d-none d-md-block ms-2 fw-bold px-4">Tìm Kiếm</button>
            </div>
            
            <div class="px-3 pt-3 pb-2 border-top mt-2 d-flex align-items-center flex-wrap gap-4 bg-white rounded-bottom">
                <!-- Mức giá -->
                <div class="d-flex align-items-center gap-2 flex-grow-1 flex-md-grow-0">
                    <label class="text-muted small fw-bold mb-0 text-nowrap"><i class="bi bi-cash-stack text-success"></i> Khoảng giá:</label>
                    <div class="d-flex align-items-center">
                        <input type="number" name="minPrice" value="@Model.MinPrice" class="form-control form-control-sm bg-light border-0 fw-medium text-center" placeholder="Từ (VND)" style="width: 110px;">
                        <span class="text-muted mx-1">-</span>
                        <input type="number" name="maxPrice" value="@Model.MaxPrice" class="form-control form-control-sm bg-light border-0 fw-medium text-center" placeholder="Đến (VND)" style="width: 110px;">
                    </div>
                </div>

                <!-- Thời lượng -->
                <div class="d-flex align-items-center gap-2 flex-grow-1 flex-md-grow-0">
                    <label class="text-muted small fw-bold mb-0 text-nowrap"><i class="bi bi-clock-history text-primary"></i> Thời lượng:</label>
                    <select name="duration" class="form-select form-select-sm bg-light border-0 fw-medium" style="width: 140px; cursor: pointer;">
                        <option value="">Tất cả</option>
                        @if (Model.Duration == "1-3") { <option value="1-3" selected>1 - 3 ngày</option> } else { <option value="1-3">1 - 3 ngày</option> }
                        @if (Model.Duration == "4-5") { <option value="4-5" selected>4 - 5 ngày</option> } else { <option value="4-5">4 - 5 ngày</option> }
                        @if (Model.Duration == "6+") { <option value="6+" selected>Trên 5 ngày</option> } else { <option value="6+">Trên 5 ngày</option> }
                    </select>
                </div>
                
                <button type="submit" class="btn search-btn btn-sm d-md-none ms-auto mt-2 w-100 fw-bold">Tìm Kiếm</button>
            </div>
        </form>
    </div>
</div>

<!-- Info Highlights Grid -->
<div class="row g-4 mb-5">
    <div class="col-md-3 col-sm-6">
        <div class="info-card text-center shadow-sm">
            <div class="text-primary mb-3"><i class="bi bi-globe fs-1"></i></div>
            <h5 class="fw-bold">Điểm Đến Đa Dạng</h5>
            <p class="text-muted small mb-0">Hàng trăm điểm hành trình trong nước và quốc tế hấp dẫn.</p>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="info-card text-center shadow-sm">
            <div class="text-success mb-3"><i class="bi bi-shield-check fs-1"></i></div>
            <h5 class="fw-bold">Bảo Đảm An Toàn</h5>
            <p class="text-muted small mb-0">Dịch vụ chuẩn y tế, an toàn và lịch trình tối ưu nhất.</p>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="info-card text-center shadow-sm">
            <div class="text-warning mb-3"><i class="bi bi-star-fill fs-1"></i></div>
            <h5 class="fw-bold">Chất Lượng 5 Sao</h5>
            <p class="text-muted small mb-0">Khách sạn tiêu chuẩn cao cấp, đội ngũ hướng dẫn tận tâm.</p>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="info-card text-center shadow-sm">
            <div class="text-danger mb-3"><i class="bi bi-tags-fill fs-1"></i></div>
            <h5 class="fw-bold">Giá Tốt Độc Quyền</h5>
            <p class="text-muted small mb-0">Nhiều chương trình khuyến mãi ưu đãi đặt chỗ sớm hấp dẫn.</p>
        </div>
    </div>
</div>

<!-- Tour Section -->
<div>
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h2 class="section-title">Các Tour Đang Mở Đăng Ký</h2>
    </div>

    <div class="row">
        @if (Model.Schedules.Any())
        {
            @foreach (var schedule in Model.Schedules)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden tour-card">
                        <!-- Image -->
                        <div class="card-img-wrapper position-relative">
                            <img src="@(string.IsNullOrEmpty(schedule.Tour?.Image) ? "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=600&auto=format&fit=crop" : schedule.Tour.Image)" class="tour-img" alt="@schedule.Tour?.TourName">
                            <span class="position-absolute top-0 start-0 bg-danger text-white px-3 py-1 m-3 rounded-pill fw-bold text-uppercase shadow-sm" style="font-size: 0.75rem; z-index: 2; letter-spacing: 0.5px;">
                                Vé Bán Chạy
                            </span>
                        </div>
                        
                        <!-- Card Body -->
                        <div class="card-body d-flex flex-column p-4">
                            <div class="text-muted mb-2 d-flex align-items-center gap-2" style="font-size: 0.85rem;">
                                <span class="text-primary fw-bold"><i class="bi bi-geo-alt-fill me-1"></i> @schedule.Tour?.Destination</span>
                                <span>•</span>
                                <span class="fw-semibold text-secondary"><i class="bi bi-clock me-1"></i> @schedule.Tour?.Days Ngày @schedule.Tour?.Nights Đêm</span>
                            </div>
                            
                            <h5 class="card-title fw-bold text-dark mb-3" style="font-size: 1.15rem; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 3.2rem;">
                                @schedule.Tour?.TourName
                            </h5>
                            
                            <div class="mt-auto">
                                <div class="row g-2 mb-3 align-items-center bg-light p-2 rounded-3">
                                    <div class="col-6 border-end">
                                        <small class="text-muted d-block" style="font-size: 0.75rem;"><i class="bi bi-calendar-event me-1"></i> Khởi hành:</small>
                                        <span class="fw-bold text-dark" style="font-size: 0.85rem;">@schedule.StartDate.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <div class="col-6 text-center">
                                        <small class="text-muted d-block" style="font-size: 0.75rem;"><i class="bi bi-people me-1"></i> Số chỗ trống:</small>
                                        <span class="badge rounded-pill pax-badge px-3 py-1">@schedule.AvailableSeats chỗ</span>
                                    </div>
                                </div>
                                
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-muted d-block" style="font-size: 0.75rem;">Giá từ:</small>
                                        <span class="price-tag">@schedule.ActualAdultPrice.ToString("N0") <small class="fs-6 fw-normal text-muted">VND</small></span>
                                    </div>
                                    <div>
                                        <a href="/Tours/Details?scheduleId=@schedule.ScheduleId" class="btn btn-details rounded-pill px-4 py-2 fw-semibold">
                                            Xem Chi Tiết
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="py-5 bg-white rounded-4 shadow-sm border border-dashed">
                    <i class="bi bi-calendar-x fs-1 text-muted d-block mb-3"></i>
                    <h4 class="text-dark fw-bold">Không tìm thấy tour du lịch nào</h4>
                    <p class="text-muted mb-0">Thử tìm kiếm với từ khóa khác hoặc quay lại trang chủ.</p>
                    <a href="/Index" class="btn btn-primary rounded-pill px-4 mt-3">Tải lại danh sách</a>
                </div>
            </div>
        }
    </div>
</div>
